{
  // Lint-only project. The build tsconfigs deliberately exclude tests and config
  // files so they are not emitted into dist — but typed linting still needs type
  // information for them, so this config includes everything.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "allowJs": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "*.mts",
    "*.mjs"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/db/src/generated/**",
    // The Mini App is a browser program: DOM lib, bundler resolution, `.vue`
    // imports. It has its own lint project in eslint.config.mjs, because putting
    // it in this Node-typed one would report `window` as undefined.
    "apps/miniapp/**"
  ]
}
