# Secrets — never commit. Only the templates are tracked.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secrets/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Prisma generated client
packages/db/src/generated/
**/.prisma/

# Test / coverage
coverage/
.vitest/
*.lcov

# Local data
postgres-data/
redis-data/
uploads/
backups/

# Local run state: PID files, per-service logs, tunnel URLs, the Mini App mode.
# Written by `make dev` (tools/devstack.sh), never by a build.
.dev/

# Deploy state on a server: which release is running, and which to roll back to.
# Written by scripts/deploy.sh, and specific to one machine.
.deploy/

# Locally downloaded installers (e.g. the cloudflared package for `make tunnel`).
*.deb

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Two files that are deliberately local-only, listed here so that a `git add -A`
# cannot sweep them in again. It did once: v0.6.6's tag carried the deployment
# notes, and `deploy.sh` refused to check the tag out on a server where the
# untracked original was in the way — which is the failure that found it.
docs/production-deployment-todo.md
.claude-work-checkpoint.md
