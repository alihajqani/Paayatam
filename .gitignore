# Secrets — never commit. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Prisma generated client
packages/db/src/generated/
**/.prisma/

# Test / coverage
coverage/
.vitest/
*.lcov

# Local data
postgres-data/
redis-data/
uploads/
backups/

# Local run state: PID files, per-service logs, tunnel URLs, the Mini App mode.
# Written by `make dev` (tools/devstack.sh), never by a build.
.dev/

# Locally downloaded installers (e.g. the cloudflared package for `make tunnel`).
*.deb

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
