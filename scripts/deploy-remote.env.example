# Settings for scripts/deploy-remote.sh.
#
# Copy this file to  ~/.config/payatam/remote.env  (works from any checkout) or to
# .deploy/remote.env  inside the repository (git-ignored), and fill it in.
# NEVER commit the real file, and never put a password or a key in it: SSH
# authentication belongs in ~/.ssh, not here.
#
# One KEY=VALUE per line. The file is read, not executed, so no $(...) or ${...}.
# An environment variable of the same name overrides the file.

# Required. An alias from ~/.ssh/config (recommended: `ssh <alias>` must work
# without a password prompt) or user@host.
DEPLOY_SSH_TARGET=your-server-alias

# Where the repository is checked out on the server.
# DEPLOY_REMOTE_DIR=/srv/payetam

# Where release bundles and the runner are dropped on the server.
# DEPLOY_TRANSFER_DIR=/root/deploy-transfer

# Extra ssh/scp options, space separated, absolute paths only (no ~).
# DEPLOY_SSH_OPTS=-i /home/you/.ssh/id_ed25519

# Tracked files that are edited on the server by hand and must survive a deploy
# (space separated, relative to DEPLOY_REMOTE_DIR). Each is copied aside, stashed
# for the deploy and restored afterwards. Set it to nothing to disable.
# DEPLOY_OOB_FILES=docker/sites-available/app.paayatam.online.conf
