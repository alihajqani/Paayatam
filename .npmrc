# Network settings tuned for a constrained link.
#
# This was not premature: a first install here saw ERR_SOCKET_TIMEOUT on several
# packages and one metadata request that took 626 seconds. The machine reaches the
# registry through an L2TP tunnel with MTU 1400, and pnpm's default of 16 parallel
# sockets saturates it badly enough that requests time out rather than merely being
# slow. Fewer connections finish faster here.
network-concurrency=4
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000

# Peers are resolved automatically; a strict failure on a transitive peer mismatch
# would block installs for reasons unrelated to this codebase.
strict-peer-dependencies=false
auto-install-peers=true
