# PayeTam — production environment template (M20).
#
#   cp .env.production.example .env
#   chmod 600 .env
#   nano .env
#
# PLACEHOLDERS ONLY. Every `CHANGE_ME` below has to be replaced before the stack
# will start. Never commit a filled-in copy: `.env` is gitignored, this template
# is not, and CI fails the build if a tracked `.env` ever appears.
#
# ── Generating the secrets ───────────────────────────────────────────────────
#
# Run these once, paste each result into the matching line, and store the whole
# set in a password manager. Do not keep the output in your shell history.
#
#   openssl rand -hex 24      # TELEGRAM_WEBHOOK_SECRET_PATH
#   openssl rand -hex 32      # TELEGRAM_WEBHOOK_SECRET_TOKEN
#   openssl rand -base64 32   # CHAT_ENCRYPTION_KEY
#   openssl rand -base64 32   # PII_HASH_PEPPER
#   openssl rand -base64 48   # JWT_ACCESS_SECRET
#   openssl rand -base64 48   # JWT_REFRESH_SECRET
#   openssl rand -base64 24   # POSTGRES_PASSWORD
#   openssl rand -base64 24   # REDIS_PASSWORD
#
# `scripts/check-env.sh` verifies the result before a deploy: that nothing is
# still a placeholder, that the key lengths are right, and that the passwords
# embedded in DATABASE_URL and REDIS_URL match POSTGRES_PASSWORD and
# REDIS_PASSWORD. Run it after editing this file.
#
# ── One rule about this file's syntax ────────────────────────────────────────
#
# **No `${…}` references.** Docker Compose's `env_file` and Node's `--env-file`
# both read it literally, so `${POSTGRES_PASSWORD}` inside DATABASE_URL arrives
# as those seventeen characters and the connection fails with an authentication
# error that points nowhere near the cause. Write the password out twice; the
# check script is what keeps the two copies equal.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
# The origin the Mini App is served from. Validated at boot.
PUBLIC_API_URL=https://app.paayatam.online

# ── Deployment topology ────────────────────────────────────────────────────────
# The subnet nginx sits on (docker/docker-compose.prod.yml pins it). Without this,
# the API sees nginx's address as every caller's: one shared IP rate-limit bucket
# for the whole internet, and one identical ip_hash for every audit row.
# `true` is REFUSED — it would let any client forge X-Forwarded-For.
TRUST_PROXY=172.28.0.0/24

# ── Database ───────────────────────────────────────────────────────────────────
# `postgres` is the compose service name; there is no host port to reach.
# The password here MUST equal POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://payetam:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/payetam?schema=public
#   openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# TEST_DATABASE_URL belongs to the integration suite and must NOT be set here.
# The suite TRUNCATEs every table before each test.

# ── Redis ──────────────────────────────────────────────────────────────────────
# The password here MUST equal REDIS_PASSWORD below. Note the empty username
# before the colon — that is the correct form for a `requirepass`-only Redis.
REDIS_URL=redis://:CHANGE_ME_SAME_AS_REDIS_PASSWORD@redis:6379
#   openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# BullMQ key namespace. Keep it distinct from every other environment, or a
# staging worker will consume production jobs.
QUEUE_PREFIX=payetam:prod

# ── Telegram ───────────────────────────────────────────────────────────────────
# From @BotFather. This is full control of the bot — treat it as the most
# damaging single value in this file after CHAT_ENCRYPTION_KEY.
TELEGRAM_BOT_TOKEN=CHANGE_ME_FROM_BOTFATHER
# The bot's username, without the leading @. Used to build deep links in channel
# posts; a wrong value produces broken links rather than a wrong destination.
TELEGRAM_BOT_USERNAME=paayatam_bot
# `polling` is REFUSED when NODE_ENV=production (ADR-0004).
TELEGRAM_MODE=webhook
# The secret segment of the webhook path. Registering the webhook uses it:
#   https://app.paayatam.online/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET_PATH>
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET_PATH=CHANGE_ME_openssl_rand_hex_24
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token, compared in constant time.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Channel for boosted posts. Leave empty if there is no channel — an id looks
# like -1001234567890, or @channelname for a public one.
TELEGRAM_CHANNEL_ID=

# ── Monitoring ─────────────────────────────────────────────────────────────────
# The Telegram group the worker posts operational alerts to: exhausted jobs,
# failed backups, a failed deploy. Add the bot to the group, make it an admin (or
# turn off privacy mode), and read the id from getUpdates — DEPLOYMENT.md §11 has
# the exact commands. A group id is negative.
#
# Empty disables alerting and changes nothing else.
MONITORING_CHAT_ID=
# Shortest gap between two alerts about the same thing, so a queue failing every
# job cannot fill the group and get the bot rate-limited by Telegram.
MONITORING_ALERT_COOLDOWN_SECONDS=300
# Kill switch. Set to 0 to stop every alert without clearing the chat id — the way
# to silence a noisy incident at 3 a.m. and restore alerting afterwards without
# hunting for the group id again. The worker keeps logging locally either way, so
# turning this off loses delivery and not information.
MONITORING_ENABLED=1
# Floor for what is worth waking somebody for: info | warn | error.
# 'warn' in production: 'info' would deliver routine sweep results to the group,
# and an alerting channel people learn to ignore is worse than none.
MONITORING_MIN_LEVEL=warn
# Which deployment an alert came from, stamped on every message. Falls back to
# NODE_ENV, which is enough while production is the only deployment sending
# alerts — set it explicitly the moment staging also has a chat id.
MONITORING_ENVIRONMENT=production

# ── The release string — deliberately NOT a line in this file ──────────────────
#
# `PAYETAM_VERSION` is what the API answers `GET /api/v1/version` with, what both
# frontends display, and what tags every image. It reaches the API container
# through `environment:` in docker/docker-compose.prod.yml, read from the shell
# that `deploy.sh` exports it in — so it is the release actually being deployed,
# every time, with nothing to remember.
#
# Setting it here instead would be a second copy that goes stale on the release
# nobody edited it for. Compose's `environment:` beats `env_file:`, so a stray
# line here would lose anyway — quietly, which is worse than losing loudly.

# ── Cryptography ───────────────────────────────────────────────────────────────
# AES-256-GCM over chat message bodies and admin TOTP secrets.
#   openssl rand -base64 32
#
# ⛔ ROTATING THIS BREAKS EVERYTHING IT PROTECTS. Every stored message and every
# administrator's TOTP secret is encrypted under it, so changing it without a
# re-encryption job means no operator can sign in and no message can be read.
# ADR-0009: it protects dumps, backups and a stolen disk — not a compromised app
# server, which holds the key by design.
CHAT_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# Pepper for HMAC-hashing IP addresses. Raw addresses are never stored.
# Rotating it is safe but breaks comparison against historical hashes.
#   openssl rand -base64 32
PII_HASH_PEPPER=CHANGE_ME_openssl_rand_base64_32

# Mini App session tokens. Rotating these is safe: everyone is signed out and
# the Mini App signs itself back in on the next launch.
#   openssl rand -base64 48   (twice — they must differ)
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48_DIFFERENT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Localisation ───────────────────────────────────────────────────────────────
# Storage is UTC everywhere (ADR-0008). This drives policy boundaries and display.
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa-IR

# ── Media ──────────────────────────────────────────────────────────────────────
# No upload path is active in the product today. Present because the schema
# validates them; changing them has no effect yet.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_BYTES=5242880

# ── Safety rails ───────────────────────────────────────────────────────────────
# The API REFUSES TO START in production with this enabled. Set it to 1 only for
# the duration of a deliberate seed, then set it back and restart.
ALLOW_PROD_SEED=0
