// PayeTam database schema.
//
// Prisma 7: the datasource holds only the provider — connection URLs live in
// prisma.config.ts. The generator is `prisma-client` (not the legacy
// `prisma-client-js`) and its `output` is mandatory.
//
// Conventions (docs/implementation-plan.md §4):
//   - UUIDv7 primary keys: time-ordered, so index locality stays good as tables grow.
//   - `public_id` is a separate random UUID for anything exposed externally.
//   - All timestamps are timestamptz, stored UTC (ADR-0008).
//   - Money is integer Toman. Never a float.
//   - snake_case in the database, camelCase in TypeScript, bridged by @map/@@map.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API and worker are CommonJS (NestJS convention). Prisma 7 defaults to ESM.
  moduleFormat = "cjs"

  // Needed for the partial indexes this schema relies on from M5 onward — e.g.
  // "published, undeleted events" and "waitlisted participants" (ADR-0006).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED

  @@map("user_status")
}

enum OnboardingState {
  NEW
  TERMS_ACCEPTED
  PROFILE_COMPLETE

  @@map("onboarding_state")
}

/// The identity root.
///
/// `public_id` is a random UUIDv4 and is the ONLY identifier that may appear in an
/// API response or a URL (invariant 7). `id` is UUIDv7 — time-ordered, so index
/// locality stays good — and never leaves the backend.
model User {
  id              String          @id @default(uuid(7))
  publicId        String          @unique @default(uuid(4)) @map("public_id")
  status          UserStatus      @default(ACTIVE)
  onboardingState OnboardingState @default(NEW) @map("onboarding_state")
  locale          String          @default("fa-IR")
  timezone        String          @default("Asia/Tehran")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  telegramAccount TelegramAccount?
  consents        Consent[]
  profile         UserProfile?
  interests       UserInterest[]
  coinAccount     CoinAccount?
  coinLedger      CoinLedger[]
  hostedEvents    Event[]

  @@index([status])
  @@index([createdAt])
  @@map("user")
}

/// Telegram identity, deliberately in its own table.
///
/// This is the highest-value PII in the product. Keeping it here rather than as
/// columns on `user` makes ADR-0009's rule structural: only the identity module
/// ever selects this table, so a careless `include` elsewhere cannot leak a
/// Telegram ID into a response.
///
/// `telegram_user_id` is BIGINT, which Prisma maps to `bigint`. That is a useful
/// accident: `JSON.stringify` throws on a bigint, so serialising one into a
/// response fails loudly instead of leaking silently.
model TelegramAccount {
  id              String   @id @default(uuid(7))
  userId          String   @unique @map("user_id")
  telegramUserId  BigInt   @unique @map("telegram_user_id")
  usernameCached  String?  @map("username_cached")
  firstNameCached String?  @map("first_name_cached")
  languageCode    String?  @map("language_code")
  /// Set when Telegram returns 403. Delivery stops rather than burning the global
  /// rate budget on a user who cannot receive anything (ADR-0005).
  botBlocked      Boolean  @default(false) @map("bot_blocked")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_account")
}

// ─────────────────────────────────────────────────────────────────────────────
// Policies and consent
// ─────────────────────────────────────────────────────────────────────────────

enum PolicyType {
  TERMS
  PRIVACY
  COMMUNITY

  @@map("policy_type")
}

/// Versioned policy text.
///
/// Deviation from the plan: `policy_document` and `policy_version` are merged. A
/// document row would have carried nothing but a type, and the "exactly one current
/// version per type" rule is enforced by a partial unique index in the migration —
/// which is a stronger guarantee than a parent row would have given.
model PolicyVersion {
  id          String     @id @default(uuid(7))
  type        PolicyType
  version     Int
  contentMd   String     @map("content_md")
  summaryFa   String?    @map("summary_fa")
  isCurrent   Boolean    @default(false) @map("is_current")
  publishedAt DateTime   @default(now()) @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  consents Consent[]

  @@unique([type, version])
  @@index([type, isCurrent])
  @@map("policy_version")
}

enum ConsentContext {
  ONBOARDING
  REACCEPT
  CONTACT_SHARE

  @@map("consent_context")
}

/// Proof that a specific user accepted a specific policy version.
///
/// Append-only, enforced by trigger — this is evidence, and evidence that can be
/// edited is not evidence. The FK to `user` is RESTRICT rather than CASCADE for the
/// same reason: account deletion anonymises (M15), it does not erase the record
/// that consent was given.
///
/// `UNIQUE(user_id, policy_version_id, context)` is what makes accepting the terms
/// idempotent under concurrent requests — the database rejects the second write, so
/// no read-then-write race exists.
///
/// `ip_hash` is an HMAC with a server pepper. Raw IPs are never stored (ADR-0009).
model Consent {
  id              String         @id @default(uuid(7))
  userId          String         @map("user_id")
  policyVersionId String         @map("policy_version_id")
  context         ConsentContext @default(ONBOARDING)
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipHash          String?        @map("ip_hash")
  userAgentHash   String?        @map("user_agent_hash")

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, policyVersionId, context])
  @@index([userId, acceptedAt])
  @@map("consent")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog — every user-selectable list is admin-managed (plan §3.3)
//
// Nothing here is free text. A user picks a city, a district and a set of
// interests from rows that an admin created, which is what makes "an interest
// outside the admin list is rejected" a lookup rather than a validation rule
// somebody has to remember to write.
//
// `is_active` rather than deletion: a city that stops being served must not
// orphan the profiles and events that already reference it. Deactivating hides
// it from every selectable list while leaving history intact.
// ─────────────────────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  nameFa    String   @map("name_fa")
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts District[]
  profiles  UserProfile[]
  events    Event[]

  @@index([isActive, sortOrder])
  @@map("city")
}

model District {
  id        String   @id @default(uuid(7))
  cityId    String   @map("city_id")
  slug      String
  nameFa    String   @map("name_fa")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city     City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  profiles UserProfile[]
  events   Event[]

  @@unique([cityId, slug])
  @@index([cityId, isActive, sortOrder])
  @@map("district")
}

/// Activity categories — the launch is gated to two of them by feature flag (plan §2).
model Category {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  nameFa    String   @map("name_fa")
  /// An emoji or icon key rendered by the Mini App. Never a URL: the CSP forbids
  /// external hosts (ADR-0003).
  icon      String?
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  interests Interest[]
  events    Event[]

  @@index([isActive, sortOrder])
  @@map("category")
}

/// What a user says they are interested in. Grouped under a category so the
/// interest-match term in ranking (plan §11, weight .05) has something to match on.
model Interest {
  id         String   @id @default(uuid(7))
  categoryId String?  @map("category_id")
  slug       String   @unique
  nameFa     String   @map("name_fa")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  users    UserInterest[]

  @@index([isActive, sortOrder])
  @@map("interest")
}

// ─────────────────────────────────────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_SAY

  @@map("gender")
}

/// The user-facing half of an identity: what other people are allowed to see.
///
/// Split from `user` on purpose. `user` is the identity root that authentication
/// and bans hang off; this is presentation data that gets moderated, edited and
/// eventually anonymised (M15). Keeping them apart means the anonymisation job
/// clears one table rather than surgically nulling columns on the row that
/// everything else references.
///
/// `birth_year` is a year, not a date: it is the coarsest thing that still
/// answers "is this person 18?", and collecting a full birth date would be more
/// personal data than the question needs (ADR-0009).
model UserProfile {
  userId      String    @id @map("user_id")
  displayName String    @map("display_name")
  gender      Gender?
  birthYear   Int?      @map("birth_year")
  cityId      String    @map("city_id")
  districtId  String?   @map("district_id")
  bio         String?
  /// Set the first time the profile passes every completeness rule, and never
  /// moved afterwards — later edits are edits, not a second completion. It is
  /// therefore safe to read as "when did this user finish onboarding".
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([cityId, districtId])
  @@map("user_profile")
}

model UserInterest {
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interest")
}

// ─────────────────────────────────────────────────────────────────────────────
// Economy — the ledger slice (ADR-0007)
//
// Pulled forward from M9 because the onboarding reward has to be grantable
// exactly once, and "exactly once" here means a UNIQUE index on an idempotency
// key, not an application-level check. Only ONBOARDING_REWARD is written in M3;
// the rest of the enum is declared now so later milestones add rows, not types.
// ─────────────────────────────────────────────────────────────────────────────

enum CoinLedgerType {
  ONBOARDING_REWARD
  REFERRAL_REWARD
  REVIEW_REWARD
  BOOST_SPEND
  VIP_SPEND
  CANCELLATION_PENALTY
  NO_SHOW_PENALTY
  HOST_CANCELLATION_REFUND
  ADMIN_ADJUSTMENT
  REVERSAL

  @@map("coin_ledger_type")
}

/// The cached balance. A convenience, not the truth: `balance` must always equal
/// `SUM(coin_ledger.amount)` for the user, which the reconciliation test asserts.
///
/// This row is also the concurrency control for the whole economy. Every coin
/// movement takes `SELECT … FOR UPDATE` on it first, so two grants or two spends
/// for the same user serialise instead of racing.
model CoinAccount {
  userId    String   @id @map("user_id")
  balance   Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_account")
}

/// Append-only, trigger-enforced (invariant 3). Corrections are new REVERSAL rows
/// pointing at the original — nothing is ever edited or deleted.
///
/// `idempotency_key` is what makes every economic operation safe to retry: a
/// double-tapped button, a redelivered job and two concurrent requests all
/// collide on one unique index and produce one row.
model CoinLedger {
  id               String         @id @default(uuid(7))
  userId           String         @map("user_id")
  idempotencyKey   String         @unique @map("idempotency_key")
  type             CoinLedgerType
  /// Signed and never zero. Positive is a credit to the user, negative a debit.
  amount           Int
  balanceBefore    Int            @map("balance_before")
  balanceAfter     Int            @map("balance_after")
  /// A stable machine-readable reason, rendered in Persian by the client. The
  /// admin panel shows this ledger rather than a number, which is what makes
  /// "where did my coins go?" answerable (ADR-0007).
  reasonCode       String         @map("reason_code")
  actorType        ActorType      @map("actor_type")
  actorId          String?        @map("actor_id")
  refType          String?        @map("ref_type")
  refId            String?        @map("ref_id")
  /// UNIQUE, which in Postgres still allows any number of NULLs — so this reads
  /// as "a ledger row can be reversed at most once". Reversing twice would
  /// silently double a refund; the index makes it impossible.
  reversesLedgerId String?        @unique @map("reverses_ledger_id")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  reverses CoinLedger? @relation("CoinLedgerReversal", fields: [reversesLedgerId], references: [id], onDelete: Restrict)
  reversal CoinLedger? @relation("CoinLedgerReversal")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("coin_ledger")
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  REJECTED
  CANCELLED_BY_HOST
  ONGOING
  COMPLETED
  EXPIRED
  DELETED

  @@map("event_status")
}

/// The moderation verdict, tracked separately from the lifecycle status.
///
/// Two axes, not one: an event can be PUBLISHED and FLAGGED at the same time —
/// visible to users while a moderator looks at it — which is the whole point of
/// FLAG being distinct from BLOCK (ADR-0012).
enum EventModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED

  @@map("event_moderation_status")
}

enum CostType {
  FREE
  APPROX
  FIXED
  SPLIT

  @@map("cost_type")
}

/// Null means anyone may join. Only the restrictive values are enumerated, so
/// "no preference" has exactly one representation rather than two.
enum GenderPreference {
  MALE_ONLY
  FEMALE_ONLY

  @@map("gender_preference")
}

model Event {
  id          String  @id @default(uuid(7))
  publicId    String  @unique @default(uuid(4)) @map("public_id")
  hostUserId  String  @map("host_user_id")
  title       String
  description String

  /// Normalized copies, written by the application through the ADR-0012
  /// pipeline. They exist because the normalizer is TypeScript and cannot be
  /// called from a Postgres trigger: the M5 `search_vector` trigger reads these
  /// rather than re-implementing normalization in PL/pgSQL, and the M12 re-scan
  /// on a blacklist bump matches against them without re-normalizing the corpus.
  titleNormalized       String  @map("title_normalized")
  descriptionNormalized String  @map("description_normalized")

  categoryId String  @map("category_id")
  cityId     String  @map("city_id")
  districtId String? @map("district_id")

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  capacity Int
  /// Invariant 1. Only ever changed under `SELECT … FOR UPDATE` on this row (M6).
  acceptedCount Int @default(0) @map("accepted_count")

  costType CostType @map("cost_type")
  /// Integer Toman, never a float (plan §4).
  costAmount Int?    @map("cost_amount")
  costNote   String? @map("cost_note")

  rules            String?
  genderPreference GenderPreference? @map("gender_preference")
  minAge           Int?              @map("min_age")
  maxAge           Int?              @map("max_age")

  /// Stored and displayed, never fetched server-side, https only (T5.3).
  externalLink String? @map("external_link")

  status           EventStatus           @default(DRAFT)
  moderationStatus EventModerationStatus @default(PENDING) @map("moderation_status")
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(3)

  boostedUntil DateTime? @map("boosted_until") @db.Timestamptz(3)
  isVip        Boolean   @default(false) @map("is_vip")

  viewCount    Int @default(0) @map("view_count")
  requestCount Int @default(0) @map("request_count")

  /// Optimistic-concurrency token for host edits. Capacity changes use the row
  /// lock instead — a version check cannot make a counter safe.
  version Int @default(0)

  /// Maintained by the `event_search_vector_sync` trigger from the normalized
  /// columns above (ADR-0012, migration 0005).
  ///
  /// `Unsupported` because Prisma has no `tsvector` type. The consequence is
  /// that it is invisible to the generated client — which is correct here:
  /// nothing should ever select it, and every query that uses it is raw SQL in
  /// `PostgresSearchProvider`. Declaring it keeps `migrate diff` quiet about a
  /// column that genuinely exists.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  host     User      @relation(fields: [hostUserId], references: [id], onDelete: Restrict)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city     City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@index([hostUserId, createdAt])
  // Partial indexes, expressible thanks to the `partialIndexes` preview feature
  // enabled above. Keeping them in the schema rather than only in the migration
  // is what stops `migrate diff` reporting them as drift — the mistake M2 had to
  // live with for the partial UNIQUE, which `@@unique` still cannot express.
  @@index([cityId, categoryId, startsAt], map: "event_discovery_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@index([boostedUntil], map: "event_boosted_idx", where: { boostedUntil: { not: null } })
  // Search indexes (migration 0005). `ops: raw(...)` is how a GIN operator class
  // reaches the generated SQL — without it Prisma picks the default class, which
  // for a text column is not `gin_trgm_ops` and would not answer a `%` query.
  @@index([searchVector(ops: raw("tsvector_ops"))], map: "event_search_vector_idx", type: Gin)
  @@index([titleNormalized(ops: raw("gin_trgm_ops"))], map: "event_title_trgm_idx", type: Gin)
  @@index([publishedAt(sort: Desc)], map: "event_published_recent_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@index([startsAt], map: "event_upcoming_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@map("event")
}

// ─────────────────────────────────────────────────────────────────────────────
// Moderation (ADR-0012)
// ─────────────────────────────────────────────────────────────────────────────

enum BlacklistPatternType {
  EXACT
  SUBSTRING
  REGEX

  @@map("blacklist_pattern_type")
}

enum BlacklistSeverity {
  BLOCK
  FLAG

  @@map("blacklist_severity")
}

/// A monotonic counter, bumped on any change to the term list.
///
/// It exists so a decision can be explained against the rules that were in force
/// when it was made: every `moderation_case` stores the version that judged it.
/// Without that, tightening the blacklist would silently rewrite the
/// justification for every past decision.
model BlacklistVersion {
  id        String   @id @default(uuid(7))
  version   Int      @unique
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("blacklist_version")
}

model BlacklistTerm {
  id   String @id @default(uuid(7))
  /// As a moderator typed it. Kept for the admin UI; never matched against.
  termRaw String @map("term_raw")
  /// What matching actually uses — the term put through the same ADR-0012
  /// pipeline as the incoming text. Storing only the raw form would mean
  /// normalizing every term on every scan, and getting it wrong once.
  termNormalized String               @map("term_normalized")
  patternType    BlacklistPatternType @map("pattern_type")
  severity       BlacklistSeverity
  category       String?
  isActive       Boolean              @default(true) @map("is_active")
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([termNormalized, patternType])
  @@index([isActive])
  @@map("blacklist_term")
}

enum ModerationSubjectType {
  EVENT
  USER
  MESSAGE
  REVIEW

  @@map("moderation_subject_type")
}

enum ModerationTrigger {
  AUTO_BLACKLIST
  REPORT_THRESHOLD
  MANUAL

  @@map("moderation_trigger")
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED

  @@map("moderation_case_status")
}

model ModerationCase {
  id          String                @id @default(uuid(7))
  subjectType ModerationSubjectType @map("subject_type")
  subjectId   String                @map("subject_id")
  trigger     ModerationTrigger
  status      ModerationCaseStatus  @default(OPEN)

  assignedAdminId String? @map("assigned_admin_id")
  /// The blacklist version that produced this case. Null for MANUAL cases,
  /// which no version judged.
  blacklistVersion Int?   @map("blacklist_version")
  /// The terms that matched, as an allowlisted projection — id, raw term,
  /// pattern type, severity. Never the scanned text itself.
  matchedTerms     Json?  @map("matched_terms")
  reportCount      Int    @default(0) @map("report_count")

  decision     String?
  decisionNote String?   @map("decision_note")
  decidedBy    String?   @map("decided_by")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Set by a moderator when the automation was wrong. This is what turns the
  /// false-positive rate into a number rather than an impression (ADR-0012).
  falsePositive Boolean? @map("false_positive")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@map("moderation_case")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform configuration
// ─────────────────────────────────────────────────────────────────────────────

/// Runtime configuration. Every policy number in the product — penalty amounts,
/// time thresholds, ranking weights, report thresholds — lives here rather than in
/// code, so tuning is a config change with no deploy (ADR-0007, ADR-0011).
model AppSetting {
  key       String   @id
  value     Json
  /// JSON Schema used to validate `value` on write, so a typo in the admin panel
  /// cannot put the economy into an impossible state.
  valueSchema Json?  @map("value_schema")
  version   Int      @default(1)
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_setting")
}

/// Feature flags. Cities and categories are gated by these so the Tehran-only,
/// two-category launch is configuration rather than a branch (plan §2).
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  /// Optional targeting rules, e.g. percentage rollout or an allowlist.
  rollout     Json?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

enum ActorType {
  USER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

/// Append-only audit trail. Every state transition and every admin mutation writes
/// here (invariants 10 and 12).
///
/// Immutability is enforced by a database trigger installed in the migration, not
/// by convention — see migration 0001. `before`/`after` hold the changed fields
/// only, never whole rows, and never message bodies or Telegram identifiers
/// (ADR-0009, T15).
///
/// NOTE: monthly partitioning is deferred to M15 alongside the retention jobs.
/// The table is empty until then, so converting it is trivial; doing it now would
/// mean fighting Prisma's schema diffing for no benefit at zero rows.
model AuditLog {
  id         String    @id @default(uuid(7))
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id")
  before     Json?
  after      Json?
  /// HMAC of the client IP with a server pepper. We never store a raw IP (ADR-0009).
  ipHash     String?   @map("ip_hash")
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
