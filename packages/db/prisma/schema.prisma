// PayeTam database schema.
//
// Prisma 7: the datasource holds only the provider — connection URLs live in
// prisma.config.ts. The generator is `prisma-client` (not the legacy
// `prisma-client-js`) and its `output` is mandatory.
//
// Conventions (docs/implementation-plan.md §4):
//   - UUIDv7 primary keys: time-ordered, so index locality stays good as tables grow.
//   - `public_id` is a separate random UUID for anything exposed externally.
//   - All timestamps are timestamptz, stored UTC (ADR-0008).
//   - Money is integer Toman. Never a float.
//   - snake_case in the database, camelCase in TypeScript, bridged by @map/@@map.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API and worker are CommonJS (NestJS convention). Prisma 7 defaults to ESM.
  moduleFormat = "cjs"

  // Needed for the partial indexes this schema relies on from M5 onward — e.g.
  // "published, undeleted events" and "waitlisted participants" (ADR-0006).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED

  @@map("user_status")
}

enum OnboardingState {
  NEW
  TERMS_ACCEPTED
  PROFILE_COMPLETE

  @@map("onboarding_state")
}

/// The identity root.
///
/// `public_id` is a random UUIDv4 and is the ONLY identifier that may appear in an
/// API response or a URL (invariant 7). `id` is UUIDv7 — time-ordered, so index
/// locality stays good — and never leaves the backend.
model User {
  id              String          @id @default(uuid(7))
  publicId        String          @unique @default(uuid(4)) @map("public_id")
  status          UserStatus      @default(ACTIVE)
  onboardingState OnboardingState @default(NEW) @map("onboarding_state")
  locale          String          @default("fa-IR")
  timezone        String          @default("Asia/Tehran")
  /// The code this user shares to invite others (M9). An addition to §4.5, which
  /// gives `referral.code` — that column snapshots the code a referral *used*,
  /// and the referrer still needs somewhere to keep the one they hand out.
  /// Generated on first read rather than at signup, so it costs nothing for the
  /// users who never open the invite screen. Nullable for the same reason.
  referralCode    String?         @unique @map("referral_code")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  telegramAccount     TelegramAccount?
  settings            UserSettings?
  consents            Consent[]
  profile             UserProfile?
  interests           UserInterest[]
  coinAccount         CoinAccount?
  coinLedger          CoinLedger[]
  hostedEvents        Event[]
  participations      EventParticipant[]
  chatMemberships     ChatParticipant[]
  chatsClosed         AnonymousChat[]      @relation("ChatClosedBy")
  chatActions         ChatAction[]         @relation("ChatActionActor")
  trustScore          TrustScore?
  trustLedger         TrustScoreLedger[]
  referralsMade       Referral[]           @relation("ReferralsMade")
  reviewsWritten      Review[]             @relation("ReviewsWritten")
  reportsFiled        Report[]             @relation("ReportsFiled")
  notifications       Notification[]
  idempotency         RequestIdempotency[]
  reviewsReceived     Review[]             @relation("ReviewsReceived")
  referralReceived    Referral?            @relation("ReferralReceived")
  giftCodeRedemptions GiftCodeRedemption[]
  messageCampaigns    MessageCampaign[]
  messagesReceived    MessageRecipient[]
  invitationsReceived EventInvitation[]
  conversation        ConversationState?

  @@index([status])
  @@index([createdAt])
  @@map("user")
}

/// Telegram identity, deliberately in its own table.
///
/// This is the highest-value PII in the product. Keeping it here rather than as
/// columns on `user` makes ADR-0009's rule structural: only the identity module
/// ever selects this table, so a careless `include` elsewhere cannot leak a
/// Telegram ID into a response.
///
/// `telegram_user_id` is BIGINT, which Prisma maps to `bigint`. That is a useful
/// accident: `JSON.stringify` throws on a bigint, so serialising one into a
/// response fails loudly instead of leaking silently.
model TelegramAccount {
  id              String   @id @default(uuid(7))
  userId          String   @unique @map("user_id")
  telegramUserId  BigInt   @unique @map("telegram_user_id")
  usernameCached  String?  @map("username_cached")
  firstNameCached String?  @map("first_name_cached")
  languageCode    String?  @map("language_code")
  /// Set when Telegram returns 403. Delivery stops rather than burning the global
  /// rate budget on a user who cannot receive anything (ADR-0005).
  botBlocked      Boolean  @default(false) @map("bot_blocked")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_account")
}

// ─────────────────────────────────────────────────────────────────────────────
// Policies and consent
// ─────────────────────────────────────────────────────────────────────────────

enum PolicyType {
  TERMS
  PRIVACY
  COMMUNITY

  @@map("policy_type")
}

/// Where a policy version is in its authoring life (M22).
///
/// Added beside `is_current` rather than replacing it. `is_current` answers "which
/// version must a user accept?" and is enforced by a partial unique index; this
/// answers "may an author still edit this row?" — and the two are not the same
/// question. A published version that has been superseded is `PUBLISHED` and not
/// current; a draft is neither.
///
/// **Every row that existed before M22 is `PUBLISHED`**, which is what the column
/// default says and why the migration needs no backfill.
enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("policy_status")
}

/// Versioned policy text.
///
/// Deviation from the plan: `policy_document` and `policy_version` are merged. A
/// document row would have carried nothing but a type, and the "exactly one current
/// version per type" rule is enforced by a partial unique index in the migration —
/// which is a stronger guarantee than a parent row would have given.
model PolicyVersion {
  id          String       @id @default(uuid(7))
  type        PolicyType
  version     Int
  contentMd   String       @map("content_md")
  summaryFa   String?      @map("summary_fa")
  isCurrent   Boolean      @default(false) @map("is_current")
  /// Defaults to PUBLISHED so every pre-M22 row is already valid (migration 0021).
  status      PolicyStatus @default(PUBLISHED)
  /// The document's own name, distinct from its `type`. Nullable because the rows
  /// seeded before M22 have none, and inventing one for them would be writing
  /// legal text nobody approved.
  titleFa     String?      @map("title_fa")
  /// What changed since the previous version, for the person being asked to
  /// accept it again. Not a substitute for the text — a summary is not consent.
  changeSummaryFa String?  @map("change_summary_fa")
  publishedAt DateTime     @default(now()) @map("published_at") @db.Timestamptz(3)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Optimistic concurrency for two authors editing one draft (M22).
  ///
  /// A published version is immutable, so this only ever moves while `status` is
  /// DRAFT — which is the point: the row that can be overwritten is the only row
  /// that needs a token.
  revision Int @default(0)

  createdByAdminId   String? @map("created_by_admin_id")
  publishedByAdminId String? @map("published_by_admin_id")

  consents    Consent[]
  createdBy   AdminUser? @relation("PolicyCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  publishedBy AdminUser? @relation("PolicyPublishedBy", fields: [publishedByAdminId], references: [id], onDelete: SetNull)

  @@unique([type, version])
  @@index([type, isCurrent])
  /// The admin list: everything of one type, newest first, drafts included.
  @@index([type, status, version(sort: Desc)], map: "policy_version_authoring_idx")
  @@map("policy_version")
}

enum ConsentContext {
  ONBOARDING
  REACCEPT
  CONTACT_SHARE

  @@map("consent_context")
}

/// Proof that a specific user accepted a specific policy version.
///
/// Append-only, enforced by trigger — this is evidence, and evidence that can be
/// edited is not evidence. The FK to `user` is RESTRICT rather than CASCADE for the
/// same reason: account deletion anonymises (M15), it does not erase the record
/// that consent was given.
///
/// `UNIQUE(user_id, policy_version_id, context)` is what makes accepting the terms
/// idempotent under concurrent requests — the database rejects the second write, so
/// no read-then-write race exists.
///
/// `ip_hash` is an HMAC with a server pepper. Raw IPs are never stored (ADR-0009).
model Consent {
  id              String         @id @default(uuid(7))
  userId          String         @map("user_id")
  policyVersionId String         @map("policy_version_id")
  context         ConsentContext @default(ONBOARDING)
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipHash          String?        @map("ip_hash")
  userAgentHash   String?        @map("user_agent_hash")

  /// `TERMS v3` — the version identifier as it stood at the moment of acceptance,
  /// snapshotted (M22).
  ///
  /// Redundant with the join, and deliberately so: this is evidence, and evidence
  /// that depends on another row still being readable is weaker than evidence that
  /// does not. Nullable, because the rows written before M22 have no snapshot and
  /// fabricating one would be worse than leaving the join to answer for them.
  policyVersionLabel String? @map("policy_version_label")
  /// The request that recorded it, so an acceptance can be tied to the access log.
  requestId          String? @map("request_id")
  /// Which build of the Mini App the user was looking at. Safe client context —
  /// a release string, never a device fingerprint (ADR-0009).
  appVersion         String? @map("app_version")

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, policyVersionId, context])
  @@index([userId, acceptedAt])
  @@map("consent")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog — every user-selectable list is admin-managed (plan §3.3)
//
// Nothing here is free text. A user picks a city, a district and a set of
// interests from rows that an admin created, which is what makes "an interest
// outside the admin list is rejected" a lookup rather than a validation rule
// somebody has to remember to write.
//
// `is_active` rather than deletion: a city that stops being served must not
// orphan the profiles and events that already reference it. Deactivating hides
// it from every selectable list while leaving history intact.
// ─────────────────────────────────────────────────────────────────────────────

/// A province, so a picker over 1,252 cities can be two short lists instead of
/// one long one.
///
/// Added in M21 with `city.province_id` NULLABLE beside it: the column tolerating
/// a gap permanently is what lets an admin create a city before anybody has
/// decided which province it is filed under (migration 0020).
model Province {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  nameFa    String   @map("name_fa")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cities City[]

  @@index([isActive, sortOrder])
  @@map("province")
}

model City {
  id         String   @id @default(uuid(7))
  slug       String   @unique
  nameFa     String   @map("name_fa")
  /// `name_fa` through the ADR-0012 pipeline, so a search for «قايم شهر» finds
  /// «قائم‌شهر» (M22).
  ///
  /// A column rather than an expression index, for the reason `event.title_normalized`
  /// is one: the normalizer is TypeScript and cannot be called from Postgres. The
  /// migration backfills it with the subset of the pipeline that SQL can express
  /// and that these 1,252 names actually need — letter folding, ZWNJ, case — and
  /// the admin service maintains it on every write from then on.
  ///
  /// Nullable so the column can be added without a lock-taking NOT NULL rewrite;
  /// the search falls back to `name_fa` for any row that somehow has none.
  nameNormalized String? @map("name_normalized")
  isActive   Boolean  @default(false) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  /// Nullable on purpose and permanently — see migration 0020.
  provinceId String?  @map("province_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts  District[]
  profiles   UserProfile[]
  events     Event[]
  categories CityCategory[]

  province Province? @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  @@index([isActive, sortOrder])
  @@index([provinceId, isActive, sortOrder])
  /// Substring search over 1,252 names, so the picker can be a text field rather
  /// than a list nobody can scroll on a phone (M22).
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], map: "city_name_trgm_idx", type: Gin)
  /// The admin list: one province's cities, alphabetically.
  @@index([provinceId, nameFa], map: "city_province_name_idx")
  @@map("city")
}

model District {
  id        String   @id @default(uuid(7))
  cityId    String   @map("city_id")
  slug      String
  nameFa    String   @map("name_fa")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city     City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  profiles UserProfile[]
  events   Event[]

  @@unique([cityId, slug])
  @@index([cityId, isActive, sortOrder])
  @@map("district")
}

/// Activity categories — the launch is gated to two of them by feature flag (plan §2).
model Category {
  id                String   @id @default(uuid(7))
  slug              String   @unique
  nameFa            String   @map("name_fa")
  /// An emoji or icon key rendered by the Mini App. Never a URL: the CSP forbids
  /// external hosts (ADR-0003).
  icon              String?
  isActive          Boolean  @default(false) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  /// The «سایر» flag: this category invites the host to name their own activity,
  /// which lands in `event.custom_category_label`.
  ///
  /// A column rather than a `slug === 'other'` comparison, so a rename or a
  /// second catch-all is data an admin edits rather than a branch in code
  /// (migration 0020).
  allowsCustomLabel Boolean  @default(false) @map("allows_custom_label")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  interests Interest[]
  events    Event[]
  cities    CityCategory[]

  @@index([isActive, sortOrder])
  @@map("category")
}

/// What a user says they are interested in. Grouped under a category so the
/// interest-match term in ranking (plan §11, weight .05) has something to match on.
model Interest {
  id         String   @id @default(uuid(7))
  categoryId String?  @map("category_id")
  slug       String   @unique
  nameFa     String   @map("name_fa")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  users    UserInterest[]

  @@index([isActive, sortOrder])
  @@map("interest")
}

/// Which cities offer which activity category.
///
/// **An empty set means every city.** A category nobody has restricted is
/// offered nationwide, which is what all of them are today — so this table
/// starts empty and stays empty until an admin narrows one deliberately
/// (migration 0020 explains why the inverse convention was rejected).
model CityCategory {
  cityId     String   @map("city_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([cityId, categoryId])
  @@index([categoryId])
  @@map("city_category")
}

// ─────────────────────────────────────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_SAY

  @@map("gender")
}

/// The user-facing half of an identity: what other people are allowed to see.
///
/// Split from `user` on purpose. `user` is the identity root that authentication
/// and bans hang off; this is presentation data that gets moderated, edited and
/// eventually anonymised (M15). Keeping them apart means the anonymisation job
/// clears one table rather than surgically nulling columns on the row that
/// everything else references.
///
/// `birth_year` is a year, not a date: it is the coarsest thing that still
/// answers "is this person 18?", and collecting a full birth date would be more
/// personal data than the question needs (ADR-0009).
model UserProfile {
  userId      String    @id @map("user_id")
  displayName String    @map("display_name")
  gender      Gender?
  birthYear   Int?      @map("birth_year")
  cityId      String    @map("city_id")
  districtId  String?   @map("district_id")
  bio         String?
  /// Whether this user has asked not to receive event invitations (M22).
  ///
  /// A profile column rather than a preferences table, because it is the only
  /// preference the product has and a table for one boolean is a join with
  /// nothing in it. **Opt-out, not opt-in**: the top-20 selector excludes anybody
  /// with this set, and the default is false so nothing changes for existing users
  /// until they choose.
  inviteOptOut Boolean  @default(false) @map("invite_opt_out")
  /// Set the first time the profile passes every completeness rule, and never
  /// moved afterwards — later edits are edits, not a second completion. It is
  /// therefore safe to read as "when did this user finish onboarding".
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([cityId, districtId])
  @@map("user_profile")
}

model UserInterest {
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interest")
}

// ─────────────────────────────────────────────────────────────────────────────
// Economy — the ledger slice (ADR-0007)
//
// Pulled forward from M9 because the onboarding reward has to be grantable
// exactly once, and "exactly once" here means a UNIQUE index on an idempotency
// key, not an application-level check. Only ONBOARDING_REWARD is written in M3;
// the rest of the enum is declared now so later milestones add rows, not types.
// ─────────────────────────────────────────────────────────────────────────────

enum CoinLedgerType {
  ONBOARDING_REWARD
  REFERRAL_REWARD
  REVIEW_REWARD
  /// A gift or discount code the user redeemed (M18). Appended rather than folded
  /// into `ADMIN_ADJUSTMENT`, because "somebody typed a campaign code" and "a
  /// human moved a balance by hand" answer different questions in an audit and
  /// have different people to ask about them.
  GIFT_CODE_REDEEM
  BOOST_SPEND
  VIP_SPEND
  /// The three M22 sinks (phase 5). Separate values rather than one `SPEND`,
  /// for the reason `GIFT_CODE_REDEEM` is separate from `ADMIN_ADJUSTMENT`:
  /// "they made an event", "they pushed one to the channel" and "they paid to
  /// invite twenty people" answer different questions in an audit and have
  /// different people to ask about them.
  EVENT_CREATE_SPEND
  CHANNEL_POST_SPEND
  INVITE_SPEND
  CANCELLATION_PENALTY
  NO_SHOW_PENALTY
  HOST_CANCELLATION_REFUND
  ADMIN_ADJUSTMENT
  REVERSAL

  @@map("coin_ledger_type")
}

/// The cached balance. A convenience, not the truth: `balance` must always equal
/// `SUM(coin_ledger.amount)` for the user, which the reconciliation test asserts.
///
/// This row is also the concurrency control for the whole economy. Every coin
/// movement takes `SELECT … FOR UPDATE` on it first, so two grants or two spends
/// for the same user serialise instead of racing.
model CoinAccount {
  userId    String   @id @map("user_id")
  balance   Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_account")
}

/// Append-only, trigger-enforced (invariant 3). Corrections are new REVERSAL rows
/// pointing at the original — nothing is ever edited or deleted.
///
/// `idempotency_key` is what makes every economic operation safe to retry: a
/// double-tapped button, a redelivered job and two concurrent requests all
/// collide on one unique index and produce one row.
model CoinLedger {
  id               String         @id @default(uuid(7))
  userId           String         @map("user_id")
  idempotencyKey   String         @unique @map("idempotency_key")
  type             CoinLedgerType
  /// Signed and never zero. Positive is a credit to the user, negative a debit.
  amount           Int
  balanceBefore    Int            @map("balance_before")
  balanceAfter     Int            @map("balance_after")
  /// A stable machine-readable reason, rendered in Persian by the client. The
  /// admin panel shows this ledger rather than a number, which is what makes
  /// "where did my coins go?" answerable (ADR-0007).
  reasonCode       String         @map("reason_code")
  actorType        ActorType      @map("actor_type")
  actorId          String?        @map("actor_id")
  refType          String?        @map("ref_type")
  refId            String?        @map("ref_id")
  /// UNIQUE, which in Postgres still allows any number of NULLs — so this reads
  /// as "a ledger row can be reversed at most once". Reversing twice would
  /// silently double a refund; the index makes it impossible.
  reversesLedgerId String?        @unique @map("reverses_ledger_id")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  reverses CoinLedger? @relation("CoinLedgerReversal", fields: [reversesLedgerId], references: [id], onDelete: Restrict)
  reversal CoinLedger? @relation("CoinLedgerReversal")

  penalisedParticipants EventParticipant[]
  giftCodeRedemption    GiftCodeRedemption?
  messageCampaign       MessageCampaign?

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("coin_ledger")
}

/// The same enum discipline as `CoinLedgerType`: every reason the score can move
/// is declared now, so later milestones add rows rather than types. M9 writes
/// INITIAL, PROFILE_COMPLETE and ADMIN_ADJUSTMENT; the rest belong to M10–M13.
enum TrustLedgerType {
  INITIAL
  PROFILE_COMPLETE
  ATTENDANCE
  REVIEW
  CANCELLATION
  NO_SHOW
  MODERATION
  REHABILITATION
  ADMIN_ADJUSTMENT
  REVERSAL

  @@map("trust_ledger_type")
}

/// The cached reputation number, 0–100 (ADR-0007).
///
/// A cache exactly as `coin_account` is: `score` must always equal
/// `SUM(trust_score_ledger.delta)` for the user, which the reconciliation test
/// asserts. A user with no row has not moved yet and reads as the configured
/// starting score.
model TrustScore {
  userId      String   @id @map("user_id")
  score       Int
  /// Which version of the scoring rules produced the current value. Stored so a
  /// future algorithm change is visible rather than retroactive.
  algoVersion Int      @default(1) @map("algo_version")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_score")
}

/// Append-only, trigger-enforced. **This is what makes the score explainable**:
/// the admin panel renders these rows, not the number, so "why is my score 47?"
/// has a complete answer with a reason and a policy version attached (ADR-0007).
///
/// `delta` is the **effective** movement — `score_after − score_before`, after
/// clamping. A policy that says +3 for somebody already at 99 stores +1 here and
/// records the 3 it wanted in `metadata`. Storing the requested delta instead
/// would break `score == SUM(delta)` the first time anybody hit a bound, and that
/// sum is the property the reconciliation test exists to check.
model TrustScoreLedger {
  id               String          @id @default(uuid(7))
  userId           String          @map("user_id")
  idempotencyKey   String          @unique @map("idempotency_key")
  type             TrustLedgerType
  /// Effective, and permitted to be zero — unlike `coin_ledger.amount`. A rule
  /// that fires against somebody already at 100 has no effect, and the row must
  /// still be written because the row is what consumes the idempotency key: drop
  /// it and a redelivered job pays out for real once the score has room again.
  delta            Int
  scoreBefore      Int             @map("score_before")
  scoreAfter       Int             @map("score_after")
  reasonCode       String          @map("reason_code")
  algoVersion      Int             @map("algo_version")
  actorType        ActorType       @map("actor_type")
  actorId          String?         @map("actor_id")
  refType          String?         @map("ref_type")
  refId            String?         @map("ref_id")
  /// UNIQUE, and Postgres treats NULLs as distinct — so this reads as "a row can
  /// be reversed at most once".
  reversesLedgerId String?         @unique @map("reverses_ledger_id")
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  reverses TrustScoreLedger? @relation("TrustLedgerReversal", fields: [reversesLedgerId], references: [id], onDelete: Restrict)
  reversal TrustScoreLedger? @relation("TrustLedgerReversal")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("trust_score_ledger")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED

  @@map("referral_status")
}

/// Why a referral was rejected (M19).
///
/// A **code**, not free text, for the reason every other terminal state in the
/// product carries one: it has to be countable ("how many do we reject for
/// velocity?") and it has to be renderable in Persian to the person it happened
/// to. The free-text half is `review_note`, which stays internal — telling a
/// suspected farmer which signal fired is telling them what to change.
///
/// **`PENDING` is not a rejection.** A referral whose qualifying attendance has
/// simply not happened yet stays `PENDING` indefinitely if need be; rejecting it
/// would be the automatic refusal T6 exists to avoid, and a wrong one silently
/// steals a real user's reward.
enum ReferralRejectionReason {
  /// The referrer and the referred user are the same person. Also a CHECK.
  SELF_REFERRAL
  /// This user already had a referrer. Also a UNIQUE.
  DUPLICATE
  /// The code did not resolve, or the referrer is banned.
  INVALID_CODE
  /// A human read `fraud_signals` and agreed with them.
  FRAUD
  /// The qualifying action can never happen — a deleted account, an anonymised
  /// profile. Distinct from "has not happened yet", which is `PENDING`.
  INELIGIBLE
  /// Everything else a named admin signed for.
  ADMIN_DECISION

  @@map("referral_rejection_reason")
}

/// Who invited whom (T6).
///
/// `referred_user_id` is UNIQUE, so a user has at most one referrer — for life,
/// and enforced by the database rather than by a check somebody has to remember.
/// The reward is not granted on signup but on **attendance**, because a referral
/// that pays out for creating an account pays out for creating accounts.
model Referral {
  id             String         @id @default(uuid(7))
  referrerUserId String         @map("referrer_user_id")
  /// One referrer per person, ever.
  referredUserId String         @unique @map("referred_user_id")
  /// The code as it was used, snapshotted. The referrer's *current* code lives on
  /// `user.referral_code` and may be rotated; this records what was actually
  /// presented, the same way `cancellation_bucket` records the policy that
  /// actually applied.
  code           String
  status         ReferralStatus @default(PENDING)
  qualifiedAt    DateTime?      @map("qualified_at") @db.Timestamptz(3)
  /// The referrer's reward row. The referred user's is found by its idempotency
  /// key; only one of the two needs a column to make the pair traceable.
  rewardLedgerId String?        @map("reward_ledger_id")
  /// Velocity and pattern signals for admin review (T6). Never an automatic
  /// rejection: a false positive here silently steals somebody's reward.
  fraudSignals   Json?          @map("fraud_signals")

  /// The rejection, if there was one (M19). All of these move together, and two
  /// CHECKs say so: `status = 'REJECTED'` requires a timestamp and a reason, and
  /// anything else requires neither. It is §7's rule for a moderation case —
  /// "terminal states require `decided_by` + `decision_note`" — applied to the
  /// other terminal decision in the product that withholds money.
  rejectedAt        DateTime?                @map("rejected_at") @db.Timestamptz(3)
  rejectionReason   ReferralRejectionReason? @map("rejection_reason")
  /// Null when the state machine rejected it rather than a person — the enum has
  /// values for both, and "which admin?" must not be answerable when none did.
  rejectedByAdminId String?                  @map("rejected_by_admin_id")
  /// Internal only, never projected to either user: naming the signal that fired
  /// is telling a farmer what to change next time.
  reviewNote        String?                  @map("review_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  referrer   User       @relation("ReferralsMade", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referred   User       @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Restrict)
  rejectedBy AdminUser? @relation(fields: [rejectedByAdminId], references: [id], onDelete: SetNull)

  @@index([referrerUserId, createdAt])
  @@index([status])
  /// The admin queue: "referrals in this state, newest first". `(status)` alone
  /// has served the settlement path since 0009 and cannot order a page.
  @@index([status, createdAt])
  @@map("referral")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gift and discount codes (M18)
//
// A campaign code somebody types in exchange for coins. It is a *sibling* of
// `referral` rather than a second economy: the coins move through `CoinService`
// like every other coin in the product, so the ledger stays the single truth and
// `balance = SUM(coin_ledger.amount)` keeps holding (ADR-0007, invariant 3).
//
// Three properties are the database's rather than the service's, for the reason
// ADR-0006 gives about capacity: a read-then-write check has a window, and a
// constraint has none.
//
//   - **`code` is UNIQUE and stored already normalized** — upper-cased with
//     spaces and dashes removed, exactly what `normalizeCode` produces for a
//     referral code. Case-insensitivity is therefore a property of the column
//     rather than of every query that touches it, and `citext` is not needed.
//   - **One redemption row per `(gift_code, user, seq)`**, so a code that allows
//     three redemptions per person allows exactly three and a single-use code
//     allows exactly one — whatever the client retries.
//   - **`redeemed_count <= max_redemptions`** is a CHECK, so the global cap
//     survives a future code path that forgets to take the row lock.
// ─────────────────────────────────────────────────────────────────────────────

/// A redeemable code.
///
/// Everything that decides whether a redemption is allowed lives here, in the
/// database, and nothing lives in the client: the coin amount, the window, the
/// two limits and the kill switch. Plan §11's rule — "all tunable numbers in the
/// database" — applies to a campaign the same way it applies to a policy.
model GiftCode {
  id       String @id @default(uuid(7))
  /// The handle every admin URL and every response uses (M19, ADR-0016).
  ///
  /// A random UUIDv4, exactly as `user.public_id` and `event.public_id` are, and
  /// added for a reason narrower than convention: **the code itself is a bearer
  /// secret**, and `POST /admin/v1/gift-codes/NOWRUZ1405/active` writes it into
  /// every access log, proxy log and browser history between the operator and the
  /// database. ADR-0015 said "never log raw gift codes" and then put one in a URL
  /// path. This is what a code is addressed by instead.
  publicId String @unique @default(uuid(4)) @map("public_id")
  /// Normalized on write: upper-case, no spaces, no dashes. The UNIQUE is what
  /// makes «abc-123» and «ABC123» the same code rather than two.
  code     String @unique

  /// What redeeming grants. Positive integer Toman-free coins — never a float,
  /// never client-supplied (plan §4).
  coins Int

  /// How many redemptions exist in total. Null is unlimited, which is the honest
  /// representation of "no cap" — a very large number would look like a cap
  /// somebody chose.
  maxRedemptions Int? @map("max_redemptions")
  /// How many one person may make. Defaults to 1, because a gift code that can be
  /// redeemed twice by the same person is usually a mistake rather than a plan.
  perUserLimit   Int  @default(1) @map("per_user_limit")
  /// Maintained under the row lock the redemption takes. A cache of
  /// `COUNT(gift_code_redemption)`, and the CHECK below is what keeps it honest.
  redeemedCount  Int  @default(0) @map("redeemed_count")

  /// The window. Both nullable: a code with neither is live from creation until
  /// somebody disables it.
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  /// The kill switch, separate from the window (ADR-0007's argument for
  /// `channel.enabled`): a campaign that has to stop *now* must not require
  /// back-dating an expiry.
  isActive Boolean @default(true) @map("is_active")

  /// What this campaign is, for whoever reads the list in six months.
  note String?

  /// The campaign this code belongs to (M19).
  ///
  /// A **label**, not a foreign key to a `campaign` table, and the choice is
  /// deliberate: a campaign has no attribute of its own that is not already on
  /// its codes, so a table would be a join whose only column is the name — and a
  /// foreign key would make "rename the campaign" a migration instead of an
  /// UPDATE. Nullable because a one-off support gesture is not a campaign, and
  /// bucketing it under one would make the roll-up describe nothing.
  campaign String?

  /// The bulk mint this code came out of (M19). One `randomUUID` per request, so
  /// "show me what I just generated" is a `WHERE` — and the operator who closed
  /// the tab can still find *which* codes they made, count them and disable the
  /// lot, even though the codes themselves are gone by design (ADR-0016).
  batchId String? @map("batch_id")

  /// The staff account that created it. Null for a code seeded by a script.
  createdByAdminId String? @map("created_by_admin_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   AdminUser?           @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  redemptions GiftCodeRedemption[]

  /// The admin list, newest first.
  @@index([createdAt])
  /// The redemption lookup is by `code`, which the UNIQUE already answers; this
  /// one is for "which campaigns are live?" on the admin list.
  @@index([isActive, expiresAt])
  /// Campaign roll-ups, and "everything I minted a moment ago" (M19).
  @@index([campaign, createdAt])
  @@index([batchId])
  @@map("gift_code")
}

/// One redemption, and the row that makes a repeat impossible.
///
/// `seq` is the 1-based ordinal of this user's redemptions of this code,
/// allocated under the `gift_code` row lock. Without it a `UNIQUE (code, user)`
/// could not express `per_user_limit > 1`; with it, the unique index is the guard
/// for every limit rather than only for the single-use case.
///
/// `coin_ledger_id` is the payment. It is NOT NULL and UNIQUE: a redemption that
/// granted nothing is not a redemption, and a ledger row cannot be claimed by two
/// of them.
model GiftCodeRedemption {
  id           String @id @default(uuid(7))
  giftCodeId   String @map("gift_code_id")
  userId       String @map("user_id")
  /// 1-based, per (code, user).
  seq          Int
  /// What was actually granted, snapshotted — `gift_code.coins` may be retuned
  /// later and this must stay explainable against what was paid.
  coins        Int
  /// The coin movement this redemption produced.
  coinLedgerId String @unique @map("coin_ledger_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  giftCode GiftCode   @relation(fields: [giftCodeId], references: [id], onDelete: Restrict)
  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger   CoinLedger @relation(fields: [coinLedgerId], references: [id], onDelete: Restrict)

  /// The guard. Two concurrent redemptions of a single-use code race to insert
  /// `seq = 1` and exactly one wins.
  @@unique([giftCodeId, userId, seq])
  /// "How many has this person had?" — read while holding the code's row lock.
  @@index([userId, createdAt])
  /// Per-code analytics (M19): first and last redemption, the trend over a window
  /// and the distinct-user count. Without it every one of those is a scan of the
  /// whole table for a campaign that may be a hundredth of it.
  @@index([giftCodeId, createdAt])
  @@map("gift_code_redemption")
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  REJECTED
  CANCELLED_BY_HOST
  ONGOING
  COMPLETED
  EXPIRED
  DELETED

  @@map("event_status")
}

/// The moderation verdict, tracked separately from the lifecycle status.
///
/// Two axes, not one: an event can be PUBLISHED and FLAGGED at the same time —
/// visible to users while a moderator looks at it — which is the whole point of
/// FLAG being distinct from BLOCK (ADR-0012).
enum EventModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED

  @@map("event_moderation_status")
}

enum CostType {
  FREE
  APPROX
  FIXED
  SPLIT

  @@map("cost_type")
}

/// Null means anyone may join. Only the restrictive values are enumerated, so
/// "no preference" has exactly one representation rather than two.
enum GenderPreference {
  MALE_ONLY
  FEMALE_ONLY

  @@map("gender_preference")
}

model Event {
  id          String @id @default(uuid(7))
  publicId    String @unique @default(uuid(4)) @map("public_id")
  hostUserId  String @map("host_user_id")
  title       String
  description String

  /// Normalized copies, written by the application through the ADR-0012
  /// pipeline. They exist because the normalizer is TypeScript and cannot be
  /// called from a Postgres trigger: the M5 `search_vector` trigger reads these
  /// rather than re-implementing normalization in PL/pgSQL, and the M12 re-scan
  /// on a blacklist bump matches against them without re-normalizing the corpus.
  titleNormalized       String @map("title_normalized")
  descriptionNormalized String @map("description_normalized")

  categoryId          String  @map("category_id")
  /// What the host called it, when the category `allowsCustomLabel` («سایر»).
  ///
  /// Blacklist-scanned on write like the title, but deliberately absent from
  /// `search_vector` — migration 0020 says why widening the 0005 trigger was the
  /// wrong trade.
  customCategoryLabel String? @map("custom_category_label")
  cityId              String  @map("city_id")
  districtId          String? @map("district_id")

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  capacity      Int
  /// Invariant 1. Only ever changed under `SELECT … FOR UPDATE` on this row (M6).
  acceptedCount Int @default(0) @map("accepted_count")

  costType   CostType @map("cost_type")
  /// Integer Toman, never a float (plan §4).
  costAmount Int?     @map("cost_amount")
  costNote   String?  @map("cost_note")

  rules            String?
  genderPreference GenderPreference? @map("gender_preference")
  minAge           Int?              @map("min_age")
  maxAge           Int?              @map("max_age")

  /// Stored and displayed, never fetched server-side, https only (T5.3).
  externalLink String? @map("external_link")

  status           EventStatus           @default(DRAFT)
  moderationStatus EventModerationStatus @default(PENDING) @map("moderation_status")
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(3)

  boostedUntil DateTime? @map("boosted_until") @db.Timestamptz(3)
  isVip        Boolean   @default(false) @map("is_vip")

  viewCount    Int @default(0) @map("view_count")
  requestCount Int @default(0) @map("request_count")

  /// Optimistic-concurrency token for host edits. Capacity changes use the row
  /// lock instead — a version check cannot make a counter safe.
  version Int @default(0)

  /// Maintained by the `event_search_vector_sync` trigger from the normalized
  /// columns above (ADR-0012, migration 0005).
  ///
  /// `Unsupported` because Prisma has no `tsvector` type. The consequence is
  /// that it is invisible to the generated client — which is correct here:
  /// nothing should ever select it, and every query that uses it is raw SQL in
  /// `PostgresSearchProvider`. Declaring it keeps `migrate diff` quiet about a
  /// column that genuinely exists.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  host         User               @relation(fields: [hostUserId], references: [id], onDelete: Restrict)
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city         City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district     District?          @relation(fields: [districtId], references: [id], onDelete: Restrict)
  participants EventParticipant[]
  reviews      Review[]
  reviewPairs  ReviewPair[]
  channelPosts ChannelPost[]
  chats        AnonymousChat[]
  invitations  EventInvitation[]
  campaigns    MessageCampaign[]

  @@index([status, startsAt])
  @@index([hostUserId, createdAt])
  // Partial indexes, expressible thanks to the `partialIndexes` preview feature
  // enabled above. Keeping them in the schema rather than only in the migration
  // is what stops `migrate diff` reporting them as drift — the mistake M2 had to
  // live with for the partial UNIQUE, which `@@unique` still cannot express.
  @@index([cityId, categoryId, startsAt], map: "event_discovery_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@index([boostedUntil], map: "event_boosted_idx", where: { boostedUntil: { not: null } })
  // Search indexes (migration 0005). `ops: raw(...)` is how a GIN operator class
  // reaches the generated SQL — without it Prisma picks the default class, which
  // for a text column is not `gin_trgm_ops` and would not answer a `%` query.
  @@index([searchVector(ops: raw("tsvector_ops"))], map: "event_search_vector_idx", type: Gin)
  @@index([titleNormalized(ops: raw("gin_trgm_ops"))], map: "event_title_trgm_idx", type: Gin)
  @@index([publishedAt(sort: Desc)], map: "event_published_recent_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@index([startsAt], map: "event_upcoming_idx", where: { status: "PUBLISHED", deletedAt: null })
  @@map("event")
}

// ─────────────────────────────────────────────────────────────────────────────
// Participation (ADR-0006)
//
// One row per (event, user), enforced by a UNIQUE index rather than by an
// application check — invariant 4. A read-then-write "has this person already
// asked?" test has a race window between the read and the insert; the constraint
// has none, so the join path inserts with ON CONFLICT DO NOTHING and reads the
// row count to decide whether it was a duplicate.
//
// There is no separate waitlist table (plan §4.3): a waitlisted user *is* an
// `event_participant` with `status = 'WAITLISTED'`, and the queue order is
// derived from `(requested_at, id)` rather than stored. Two tables would be a
// dual-write race across promotion and cancellation for no benefit.
// ─────────────────────────────────────────────────────────────────────────────

enum ParticipantStatus {
  PENDING
  WAITLISTED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED_BY_PARTICIPANT
  CANCELLED_BY_HOST
  COMPLETED
  NO_SHOW

  @@map("participant_status")
}

/// Which side of a cancellation threshold the cancellation fell on (plan §11).
///
/// Stored rather than recomputed: the thresholds live in `app_setting` and can
/// be retuned, and a penalty must stay explainable against the policy that was
/// in force when it was applied — the same argument that makes
/// `moderation_case.blacklist_version` worth storing.
enum CancellationBucket {
  GRACE
  GT_24H
  H24_TO_H3
  LT_3H
  NO_SHOW

  @@map("cancellation_bucket")
}

model EventParticipant {
  id       String @id @default(uuid(7))
  /// Exposed in URLs (`POST /participants/:publicId/accept`), so it is a random
  /// UUIDv4 like every other externally visible identifier. The internal id is
  /// time-ordered and never leaves the backend (invariant 7).
  publicId String @unique @default(uuid(4)) @map("public_id")

  eventId String @map("event_id")
  userId  String @map("user_id")

  status ParticipantStatus @default(PENDING)

  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// When the host accepted or rejected — the decision, not its outcome.
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// Cancel before this and the cancellation is free (plan §11: 15 minutes).
  graceExpiresAt DateTime? @map("grace_expires_at") @db.Timestamptz(3)
  /// `min(now + 24h, starts_at - 3h)`. Past it, the request expires and the seat
  /// it was holding goes back to the pool.
  hostDeadlineAt DateTime? @map("host_deadline_at") @db.Timestamptz(3)
  /// Set when a waitlisted request was promoted (M7).
  promotedAt     DateTime? @map("promoted_at") @db.Timestamptz(3)

  cancellationReason String?             @map("cancellation_reason")
  cancellationBucket CancellationBucket? @map("cancellation_bucket")
  /// The penalty row this cancellation produced (M10). Null while penalties are
  /// not yet applied, and for cancellations that cost nothing.
  penaltyLedgerId    String?             @map("penalty_ledger_id")

  /// Null until the event completes and attendance is settled (M11).
  attended Boolean?

  /// Optimistic-concurrency token for host edits of a decision. Capacity itself
  /// is protected by the event row lock, never by this — a version check cannot
  /// make a counter safe (ADR-0006).
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  penalty    CoinLedger?    @relation(fields: [penaltyLedgerId], references: [id], onDelete: Restrict)
  /// Created with the request, not with the acceptance (plan §2.5).
  chat       AnonymousChat?
  /// Both sides' reviews of this participation, and the window they share (M11).
  reviews    Review[]
  reviewPair ReviewPair?

  /// Invariant 4, and the duplicate-request guard the join path relies on.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
  /// The waitlist queue, in the order promotion reads it (ADR-0006). Partial, so
  /// it stays small on events with a long history of settled requests.
  @@index([eventId, requestedAt, id], map: "event_participant_waitlist_idx", where: { status: "WAITLISTED" })
  @@map("event_participant")
}

// ─────────────────────────────────────────────────────────────────────────────
// Anonymous chat (ADR-0009)
//
// The anonymity boundary in table form. Two strangers negotiate a real-world
// meeting before either knows who the other is, which puts three properties on
// this schema rather than on the code that uses it:
//
//   - **Nothing here can reach `telegram_account`.** A chat row names an event, a
//     participant and two users by internal id. There is no path from a message
//     to a Telegram identifier that does not go through the `identity` module,
//     which is layer 1 of §3.6.
//   - **The alias is a column, not a computation.** It is assigned per *chat*
//     from the position of that chat within its event, so it is a function of
//     (event, arrival order) and never of the person. The same user is «میهمان ۱»
//     in one event and «میهمان ۴» in another, and every event's first guest is
//     «میهمان ۱» — the number therefore carries no information about who it is,
//     which is what makes cross-chat correlation impossible rather than merely
//     hard (layer 3).
//   - **Bodies are ciphertext at rest.** `chat_message` stores AES-256-GCM bytes
//     and a per-message nonce; the metadata beside them stays in clear so
//     moderation can query patterns without decrypting anything (ADR-0009).
//
// A chat exists from the moment somebody *asks* to join, not from acceptance
// (plan §2.5). That is the product's differentiator, and it is why the status
// starts at ANONYMOUS rather than at OPEN.
// ─────────────────────────────────────────────────────────────────────────────

enum ChatStatus {
  ANONYMOUS
  OPEN
  CLOSED
  BLOCKED

  @@map("chat_status")
}

enum ChatParticipantRole {
  HOST
  GUEST

  @@map("chat_participant_role")
}

enum ChatMessageKind {
  TEXT
  SYSTEM

  @@map("chat_message_kind")
}

enum ChatActionType {
  ACCEPT
  REJECT
  CLOSE
  SHARE_CONTACT
  BLOCK

  @@map("chat_action_type")
}

model AnonymousChat {
  id       String @id @default(uuid(7))
  /// The only chat identifier that appears in a URL or a response.
  publicId String @unique @default(uuid(4)) @map("public_id")

  eventId       String @map("event_id")
  /// One chat per request (plan §4.4). The UNIQUE is what makes "this request's
  /// chat" a lookup rather than a query that could return two rows.
  participantId String @unique @map("participant_id")

  status ChatStatus @default(ANONYMOUS)

  /// The `seq` allocator, and an addition to §4.4's field list.
  ///
  /// `UNIQUE (chat_id, seq)` needs a source of gap-free per-chat numbering, and
  /// the two alternatives are both worse: `MAX(seq) + 1` races under READ
  /// COMMITTED and needs a retry loop, and `SELECT … FOR UPDATE` on this row
  /// would put a second explicit lock in a product where ADR-0006 deliberately
  /// has exactly one. `UPDATE … SET next_seq = next_seq + 1 RETURNING` is a
  /// single statement whose implicit row lock is held only for the length of the
  /// insert that follows it.
  nextSeq Int @default(0) @map("next_seq")

  openedAt       DateTime? @map("opened_at") @db.Timestamptz(3)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  closedByUserId String?   @map("closed_by_user_id")
  closeReason    String?   @map("close_reason")

  /// Set when the chat closes: `closed_at + 90 days` (ADR-0009). Null while the
  /// chat is live, which is also what makes the purge's index small — it holds
  /// closed chats rather than every chat.
  retentionExpiresAt DateTime? @map("retention_expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  closedBy    User?            @relation("ChatClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  chatParticipants ChatParticipant[]
  messages         ChatMessage[]
  actions          ChatAction[]
  unsealGrants     ChatUnsealGrant[]

  @@index([eventId])
  /// The retention purge's query (M15): closed chats whose 90 days are up.
  @@index([retentionExpiresAt], map: "anonymous_chat_retention_idx", where: { retentionExpiresAt: { not: null } })
  @@map("anonymous_chat")
}

/// One side of a chat, and where the alias lives.
///
/// The alias is stored rather than derived because it must never change: a
/// recipient who has been reading «میهمان ۲» for a week cannot have that person
/// silently renumbered because an earlier request was cancelled.
model ChatParticipant {
  id     String @id @default(uuid(7))
  chatId String @map("chat_id")
  userId String @map("user_id")

  role ChatParticipantRole

  /// Display text, in Persian digits, because it is rendered verbatim into a
  /// Telegram message. The Latin number lives in `alias_index` beside it, so
  /// nothing has to parse Persian digits back out to do arithmetic (glossary §5).
  alias      String
  /// 0 for the host; for a guest, the 1-based position of their chat within the
  /// event. Assigned under the event row lock the join already holds, which is
  /// what makes two simultaneous joiners get two different numbers.
  aliasIndex Int    @map("alias_index")

  /// When this participant consented to exchange contact details (ADR-0009).
  /// Until it is set, their outgoing messages have phone numbers, usernames and
  /// links masked; after it, they have chosen to reveal them.
  contactSharedAt DateTime? @map("contact_shared_at") @db.Timestamptz(3)
  lastReadAt      DateTime? @map("last_read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat AnonymousChat @relation(fields: [chatId], references: [id], onDelete: Restrict)
  user User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  sentMessages ChatMessage[]

  @@unique([chatId, userId])
  @@unique([chatId, aliasIndex])
  /// "Which chats am I in?" — the list endpoint's only query.
  @@index([userId])
  @@map("chat_participant")
}

/// A relayed message.
///
/// What is stored is what the *recipient* saw: the sanitizer runs before the
/// cipher, so a masked phone number is masked in the ciphertext too and the
/// platform never holds a number it refused to relay (§8 — phone numbers are
/// never stored). `redactions` records only which rules fired and how often,
/// never the removed text, exactly as `moderation_case.matched_terms` records
/// rules rather than the scanned subject (M4).
///
/// NOTE: §4.4 and §3.8 call for monthly partitioning from day one. It is deferred
/// to M15 with the retention jobs — see the M8 deviations in
/// docs/implementation-plan.md. The short version: Postgres requires the
/// partition key in every unique index, which would turn `UNIQUE (chat_id, seq)`
/// into `UNIQUE (chat_id, seq, created_at)` and let a chat that spans a month
/// boundary carry two messages with the same seq.
model ChatMessage {
  id     String @id @default(uuid(7))
  chatId String @map("chat_id")

  /// Null for a SYSTEM message: the platform is not a chat participant.
  senderParticipantId String? @map("sender_participant_id")

  /// Per-chat, gap-free, allocated from `anonymous_chat.next_seq`. This is the
  /// message identifier the API exposes — a chat-scoped ordinal tells a caller
  /// nothing they do not already have (invariant 7).
  seq Int

  kind ChatMessageKind @default(TEXT)

  /// AES-256-GCM ciphertext with the 16-byte authentication tag appended, and the
  /// per-message nonce beside it. `key_version` exists from day one so rotation is
  /// a background re-encrypt job rather than a migration under pressure.
  bodyCiphertext Bytes @map("body_ciphertext")
  bodyNonce      Bytes @map("body_nonce")
  keyVersion     Int   @map("key_version")

  /// `[{ kind, count }]` — which masking rules fired, never what they removed.
  redactions      Json @default("[]")
  /// Reserved for the M12 re-scan. Empty until moderation reads message bodies.
  moderationFlags Json @default("[]") @map("moderation_flags")

  /// The sender's own Telegram message id, when the message arrived through the
  /// bot. It is how an `edited_message` update finds the row it edits (D10);
  /// null for a message composed in the Mini App, which has no Telegram message
  /// behind it.
  sourceTelegramMessageId BigInt? @map("source_telegram_message_id")
  /// `{ "<recipient user public id>": <telegram message id> }`, filled in by the
  /// M13 relay after delivery so an edit or a delete can reach the copy.
  telegramMessageIds      Json    @default("{}") @map("telegram_message_ids")

  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  /// Set when the sender deletes: the recipient's copy becomes «پیام حذف شد»
  /// while this row survives as the evidentiary record (D10).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  retentionExpiresAt DateTime? @map("retention_expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   AnonymousChat    @relation(fields: [chatId], references: [id], onDelete: Restrict)
  sender ChatParticipant? @relation(fields: [senderParticipantId], references: [id], onDelete: Restrict)

  @@unique([chatId, seq])
  @@index([chatId, seq(sort: Desc)], map: "chat_message_recent_idx")
  /// The edit path's lookup: this sender's message with that Telegram id.
  @@index([senderParticipantId, sourceTelegramMessageId], map: "chat_message_source_idx", where: { sourceTelegramMessageId: { not: null } })
  /// The retention purge (M15).
  @@index([retentionExpiresAt], map: "chat_message_retention_idx", where: { retentionExpiresAt: { not: null } })
  @@map("chat_message")
}

/// Append-only log of what was *done* to a chat, as opposed to said in it.
///
/// Separate from `audit_log` because these are user actions inside a private
/// conversation, and ADR-0009 keeps that trail beside the conversation it belongs
/// to rather than in the trail admins read for everything else. Immutability is a
/// trigger, not a convention — a consent record that can be edited is not a
/// consent record.
model ChatAction {
  id          String  @id @default(uuid(7))
  chatId      String  @map("chat_id")
  /// Null when the platform acted — an expiry, a moderation block.
  actorUserId String? @map("actor_user_id")

  action ChatActionType
  /// Allowlisted facts only. Never a message body, never a Telegram identifier.
  detail Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat  AnonymousChat @relation(fields: [chatId], references: [id], onDelete: Restrict)
  actor User?         @relation("ChatActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([chatId, createdAt])
  @@map("chat_action")
}

// ─────────────────────────────────────────────────────────────────────────────
// Moderation (ADR-0012)
// ─────────────────────────────────────────────────────────────────────────────

enum BlacklistPatternType {
  EXACT
  SUBSTRING
  REGEX

  @@map("blacklist_pattern_type")
}

enum BlacklistSeverity {
  BLOCK
  FLAG

  @@map("blacklist_severity")
}

/// A monotonic counter, bumped on any change to the term list.
///
/// It exists so a decision can be explained against the rules that were in force
/// when it was made: every `moderation_case` stores the version that judged it.
/// Without that, tightening the blacklist would silently rewrite the
/// justification for every past decision.
model BlacklistVersion {
  id        String   @id @default(uuid(7))
  version   Int      @unique
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("blacklist_version")
}

model BlacklistTerm {
  id             String               @id @default(uuid(7))
  /// As a moderator typed it. Kept for the admin UI; never matched against.
  termRaw        String               @map("term_raw")
  /// What matching actually uses — the term put through the same ADR-0012
  /// pipeline as the incoming text. Storing only the raw form would mean
  /// normalizing every term on every scan, and getting it wrong once.
  termNormalized String               @map("term_normalized")
  patternType    BlacklistPatternType @map("pattern_type")
  severity       BlacklistSeverity
  category       String?
  isActive       Boolean              @default(true) @map("is_active")
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([termNormalized, patternType])
  @@index([isActive])
  @@map("blacklist_term")
}

enum ModerationSubjectType {
  EVENT
  USER
  MESSAGE
  REVIEW

  @@map("moderation_subject_type")
}

enum ModerationTrigger {
  AUTO_BLACKLIST
  REPORT_THRESHOLD
  MANUAL

  @@map("moderation_trigger")
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED

  @@map("moderation_case_status")
}

model ModerationCase {
  id          String                @id @default(uuid(7))
  subjectType ModerationSubjectType @map("subject_type")
  subjectId   String                @map("subject_id")
  trigger     ModerationTrigger
  status      ModerationCaseStatus  @default(OPEN)

  assignedAdminId  String? @map("assigned_admin_id")
  /// The blacklist version that produced this case. Null for MANUAL cases,
  /// which no version judged.
  blacklistVersion Int?    @map("blacklist_version")
  /// The terms that matched, as an allowlisted projection — id, raw term,
  /// pattern type, severity. Never the scanned text itself.
  matchedTerms     Json?   @map("matched_terms")
  reportCount      Int     @default(0) @map("report_count")

  decision      String?
  decisionNote  String?   @map("decision_note")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Set by a moderator when the automation was wrong. This is what turns the
  /// false-positive rate into a number rather than an impression (ADR-0012).
  falsePositive Boolean?  @map("false_positive")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reports      Report[]
  unsealGrants ChatUnsealGrant[]

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@map("moderation_case")
}

// ─────────────────────────────────────────────────────────────────────────────
// Transactional outbox (ADR-0005)
//
// A domain event is inserted in the *same transaction* as the state change that
// caused it. That single fact buys both halves of the guarantee: a crash before
// the relay runs leaves the row to be delivered on restart, and a rolled-back
// transaction leaves no row, so nothing is ever announced that did not happen.
//
// This is the producer side. The relay that reads these rows, fans them out into
// notifications and marks them processed is M13 — until then the table is a
// durable record of what happened, which is exactly what a relay would need to
// find when it arrives.
// ─────────────────────────────────────────────────────────────────────────────

model OutboxEvent {
  id String @id @default(uuid(7))

  /// What the event happened to — `event_participant`, `event`, `user`. Paired
  /// with `aggregateId` so a consumer can find the subject without parsing the
  /// payload.
  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  /// Dotted and past-tense, matching `audit_log.action`: `waitlist.promoted`.
  eventType     String @map("event_type")

  /// Allowlisted facts, never a spread of the row. These are consumed by the
  /// notification layer, which renders them into Persian text a user reads — so
  /// a Telegram identifier reaching here would reach a message body (ADR-0009).
  payload Json

  /// Null until the relay has enqueued it. The partial index below is the queue.
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The relay's only query: oldest unprocessed first. Partial, so the index
  /// holds the backlog rather than the entire history of the product.
  @@index([createdAt], map: "outbox_event_unprocessed_idx", where: { processedAt: null })
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform configuration
// ─────────────────────────────────────────────────────────────────────────────

/// Runtime configuration. Every policy number in the product — penalty amounts,
/// time thresholds, ranking weights, report thresholds — lives here rather than in
/// code, so tuning is a config change with no deploy (ADR-0007, ADR-0011).
model AppSetting {
  key         String   @id
  value       Json
  /// JSON Schema used to validate `value` on write, so a typo in the admin panel
  /// cannot put the economy into an impossible state.
  valueSchema Json?    @map("value_schema")
  version     Int      @default(1)
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_setting")
}

/// Feature flags. Cities and categories are gated by these so the Tehran-only,
/// two-category launch is configuration rather than a branch (plan §2).
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  /// Optional targeting rules, e.g. percentage rollout or an allowlist.
  rollout     Json?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

/// Stored responses for replayed `Idempotency-Key` requests (plan §6).
///
/// The problem this exists for is narrow and expensive: a host taps «برجسته کردن»,
/// the response is lost on a mobile network, and the retry spends another 40 coins.
/// Every *other* duplicate path in the product is defended by a unique index on a
/// natural key — one participation per (event, user), one review per (participation,
/// reviewer). Boost is the exception, because its natural key is a *window* rather
/// than a thing, and a second boost is something a host may legitimately want (M9).
///
/// Scoped to the user, so one caller's key can never collide with another's.
/// `requestFingerprint` is what makes a replay honest: the same key with a different
/// body is a client bug, and answering it with the first response would be worse than
/// refusing it.
model RequestIdempotency {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  key    String

  /// Method and path are stored so the same key on a different endpoint is a
  /// conflict rather than a silent cross-endpoint replay.
  method             String @db.VarChar(10)
  path               String @db.VarChar(255)
  /// SHA-256 of the request body.
  requestFingerprint String @map("request_fingerprint") @db.VarChar(64)

  /// Only successful responses are stored. A failed request must stay retryable,
  /// or a network blip would pin a user to an error for the life of the row.
  statusCode   Int    @map("status_code")
  /// The exact serialized response, not JSONB: key order is part of "identical".
  responseBody String @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Swept by the retention job. A key is a defence against a retry, and a retry
  /// that arrives a day later is a new intention.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("request_idempotency")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

enum ActorType {
  USER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

/// Append-only audit trail. Every state transition and every admin mutation writes
/// here (invariants 10 and 12).
///
/// Immutability is enforced by a database trigger installed in the migration, not
/// by convention — see migration 0001. `before`/`after` hold the changed fields
/// only, never whole rows, and never message bodies or Telegram identifiers
/// (ADR-0009, T15).
///
/// NOTE: monthly partitioning is deferred to M15 alongside the retention jobs.
/// The table is empty until then, so converting it is trivial; doing it now would
/// mean fighting Prisma's schema diffing for no benefit at zero rows.
model AuditLog {
  id         String    @id @default(uuid(7))
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id")
  before     Json?
  after      Json?
  /// HMAC of the client IP with a server pepper. We never store a raw IP (ADR-0009).
  ipHash     String?   @map("ip_hash")
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  /// The legal trail is read by action name — "every `policy.*` row" (M22).
  @@index([action, createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews (ADR-0011, D7/D7a)
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewStatus {
  SUBMITTED
  REVEALED
  HIDDEN

  @@map("review_status")
}

/// The pair's lifecycle (plan §7). `EXPIRED_PARTIAL` is D7a: the deadline passed
/// with one side written, so that side *is* revealed — the reviewer's effort stays
/// visible — but it is excluded from Trust Score, because somebody who never
/// reviewed cannot have their score moved by a counterparty they had no
/// opportunity to answer.
enum ReviewPairStatus {
  PENDING
  PARTIAL
  REVEALED
  EXPIRED_PARTIAL
  EXPIRED_EMPTY

  @@map("review_pair_status")
}

/// One side's review of the other (ADR-0011, D7).
///
/// **Nothing here is readable by the counterparty until the pair reveals**, and
/// that is enforced in the service layer rather than in the interface: the read
/// path filters on the *pair's* status, so an unrevealed review is absent from the
/// response rather than merely hidden in it (invariant 8).
model Review {
  id       String @id @default(uuid(7))
  /// Exposed in URLs, so a random UUIDv4 like every other external identifier.
  publicId String @unique @default(uuid(4)) @map("public_id")

  eventId        String @map("event_id")
  /// The participation being reviewed. Both sides of one participation share it,
  /// which is what makes `review_pair` a single row.
  participantId  String @map("participant_id")
  reviewerUserId String @map("reviewer_user_id")
  revieweeUserId String @map("reviewee_user_id")

  rating  Int
  /// Fixed vocabulary chosen by the client from a list the API publishes. Free
  /// text lives in `comment`, which is moderated; tags are not free text and so
  /// need no moderation of their own.
  tags    String[] @default([])
  comment String?

  status           ReviewStatus          @default(SUBMITTED)
  moderationStatus EventModerationStatus @default(APPROVED) @map("moderation_status")

  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  revealedAt     DateTime? @map("revealed_at") @db.Timestamptz(3)
  /// Editable only while SUBMITTED and before this (plan §11: one hour). Stored
  /// rather than recomputed, so an edit is judged against the window the reviewer
  /// was actually given — the same reasoning as `grace_expires_at`.
  editDeadlineAt DateTime  @map("edit_deadline_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reviewer    User             @relation("ReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewee    User             @relation("ReviewsReceived", fields: [revieweeUserId], references: [id], onDelete: Restrict)
  pairAsHost  ReviewPair?      @relation("PairHostReview")
  pairAsGuest ReviewPair?      @relation("PairGuestReview")

  /// Invariant 6, in the database rather than in a check somebody has to remember.
  @@unique([participantId, reviewerUserId])
  /// The public read: everything revealed about one person, newest first.
  @@index([revieweeUserId, status, submittedAt])
  @@index([eventId])
  @@map("review")
}

/// Both sides of one participation, plus the window they share (ADR-0011).
///
/// The single row is what makes "reveal both at once" atomic. Two independent
/// review rows with their own deadlines would need a second source of truth for
/// "has the other side written yet?", and the answer would be read at least once
/// while it was wrong.
model ReviewPair {
  id            String @id @default(uuid(7))
  /// One pair per participation, for life.
  participantId String @unique @map("participant_id")
  eventId       String @map("event_id")

  hostReviewId  String? @unique @map("host_review_id")
  guestReviewId String? @unique @map("guest_review_id")

  /// Event end + 24 h, and event end + 7 d (plan §11).
  opensAt    DateTime @map("opens_at") @db.Timestamptz(3)
  deadlineAt DateTime @map("deadline_at") @db.Timestamptz(3)

  status     ReviewPairStatus @default(PENDING)
  revealedAt DateTime?        @map("revealed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  hostReview  Review?          @relation("PairHostReview", fields: [hostReviewId], references: [id], onDelete: Restrict)
  guestReview Review?          @relation("PairGuestReview", fields: [guestReviewId], references: [id], onDelete: Restrict)

  /// The reveal sweep's read: `status IN ('PENDING','PARTIAL') AND deadline_at <=
  /// now`. Composite rather than partial because Prisma's `@@index` where-clause
  /// supports only equality and `not`, so a two-value `IN` predicate is not
  /// expressible — and an index Prisma cannot see is one `migrate dev` would
  /// happily drop. Leading on `status` prunes to the pairs still in play, which is
  /// what the partial predicate would have done.
  @@index([status, deadlineAt], map: "review_pair_due_idx")
  @@map("review_pair")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports (plan §4.6)
// ─────────────────────────────────────────────────────────────────────────────

/// Why somebody reported something. A closed list, so the moderation queue can be
/// filtered and counted; the free text lives in `description`.
enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  SCAM
  IMPERSONATION
  SAFETY
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED

  @@map("report_status")
}

/// One person's report of one thing (plan §4.6, invariant 5).
///
/// `UNIQUE (target_type, target_id, reporter_user_id)` is "you cannot report the
/// same thing twice", in the database. It is also what makes the auto-hide
/// threshold mean **distinct people**: counting rows counts reporters, because the
/// index makes a second row from the same person impossible.
model Report {
  id       String @id @default(uuid(7))
  publicId String @unique @default(uuid(4)) @map("public_id")

  /// Reuses `ModerationSubjectType` rather than declaring a parallel enum: a
  /// report and the case it opens are about the same kinds of thing, and two
  /// enums would drift the first time one gained a member.
  targetType     ModerationSubjectType @map("target_type")
  targetId       String                @map("target_id")
  reporterUserId String                @map("reporter_user_id")

  reason      ReportReason
  description String?

  status           ReportStatus @default(OPEN)
  moderationCaseId String?      @map("moderation_case_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter       User            @relation("ReportsFiled", fields: [reporterUserId], references: [id], onDelete: Restrict)
  moderationCase ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)

  /// Invariant 5.
  @@unique([targetType, targetId, reporterUserId])
  /// The threshold count, and the moderation queue's "what has been reported".
  @@index([targetType, targetId, status])
  @@index([status, createdAt])
  @@map("report")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin identity and RBAC (ADR-0010)
// ─────────────────────────────────────────────────────────────────────────────

enum AdminUserStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("admin_user_status")
}

/// Staff. **No foreign key to `user`, and never one** (ADR-0010).
///
/// The two identity systems share no table, no token format and no session
/// namespace, so a privilege-escalation bug in user-facing code cannot become an
/// admin compromise — and admin access does not follow from somebody's personal
/// Telegram being taken over.
model AdminUser {
  id    String @id @default(uuid(7))
  /// CITEXT, so `Ali@x.com` and `ali@x.com` are one account rather than two.
  email String @unique @db.Citext

  /// argon2id, memory-hard, per-user salt inside the encoded hash.
  passwordHash  String @map("password_hash")
  /// AES-256-GCM at rest, same cipher the chat bodies use. TOTP is **mandatory**
  /// (D11), so this is not nullable — an admin without a second factor is not a
  /// state this table can represent.
  totpSecretEnc String @map("totp_secret_enc")

  displayName String          @map("display_name")
  status      AdminUserStatus @default(ACTIVE)

  /// Progressive lockout after five failures (D11). Reset on a successful login.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles             AdminUserRole[]
  unsealGrants      ChatUnsealGrant[]
  roleChangesMade   RoleChangeRequest[] @relation("RoleChangeRequestedBy")
  roleChangesSeen   RoleChangeRequest[] @relation("RoleChangeApprovedBy")
  giftCodesCreated  GiftCode[]
  referralsRejected Referral[]
  messageCampaigns  MessageCampaign[]
  policiesDrafted   PolicyVersion[]     @relation("PolicyCreatedBy")
  policiesPublished PolicyVersion[]     @relation("PolicyPublishedBy")
  channelConfigs    EventChannelConfig[]
  requiredChannels  RequiredChannel[]

  @@index([status])
  @@map("admin_user")
}

model Role {
  id   String @id @default(uuid(7))
  /// `SUPER_ADMIN`, `MODERATOR`, `SUPPORT`, `ANALYST` (ADR-0010).
  key  String @unique
  name String

  permissions RolePermission[]
  admins      AdminUserRole[]

  @@map("role")
}

/// A fine-grained capability — `event.moderate`, `coin.adjust`, `chat.read`.
///
/// Granted to roles rather than hardcoded to role names, so adding a capability is
/// a row rather than a new code path (ADR-0010, rule 1).
model Permission {
  id          String  @id @default(uuid(7))
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id")
  roleId      String   @map("role_id")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_role")
}

enum RoleChangeStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("role_change_status")
}

/// Four-eyes on role changes (ADR-0010, rule 4).
///
/// A `SUPER_ADMIN` cannot unilaterally grant capabilities — not even to
/// themselves. The request and its approval are two rows written by two different
/// admins, and the CHECK below is what makes "different" a fact rather than a
/// convention.
model RoleChangeRequest {
  id String @id @default(uuid(7))

  /// The admin whose roles would change.
  subjectAdminId String  @map("subject_admin_id")
  roleKey        String  @map("role_key")
  /// True to grant, false to revoke.
  granting       Boolean
  reason         String

  requestedById String           @map("requested_by_id")
  approvedById  String?          @map("approved_by_id")
  status        RoleChangeStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)

  requestedBy AdminUser  @relation("RoleChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  AdminUser? @relation("RoleChangeApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("role_change_request")
}

/// A time-boxed permission to read one conversation (ADR-0010, T14).
///
/// Reading private messages requires **all three** of `chat.read`, an open
/// `moderation_case` naming that chat, and a written reason — and then only for
/// fifteen minutes. Every individual message read writes its own `audit_log` row,
/// not one row for the session, so "what did they actually look at" is answerable.
model ChatUnsealGrant {
  id String @id @default(uuid(7))

  chatId           String @map("chat_id")
  adminUserId      String @map("admin_user_id")
  moderationCaseId String @map("moderation_case_id")
  reason           String

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// Counts messages actually read under this grant, for the weekly digest.
  readCount Int      @default(0) @map("read_count")

  chat           AnonymousChat  @relation(fields: [chatId], references: [id], onDelete: Restrict)
  adminUser      AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  moderationCase ModerationCase @relation(fields: [moderationCaseId], references: [id], onDelete: Restrict)

  @@index([adminUserId, grantedAt])
  @@index([expiresAt])
  @@map("chat_unseal_grant")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications and the dead-letter queue (ADR-0005)
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  TELEGRAM

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// The bot is blocked, so there is nobody to deliver to. Terminal, and not a
  /// failure to retry — retrying a block burns the global rate budget that other
  /// users' notifications need (ADR-0005).
  UNDELIVERABLE
  /// The recipient asked not to receive this category (v0.6.1). Terminal, and
  /// deliberately not UNDELIVERABLE: that one means the bot is blocked and its
  /// helper sets `telegram_account.bot_blocked`, which would suppress everything
  /// rather than one kind and show a re-start banner to somebody who had simply
  /// turned a category off.
  SUPPRESSED

  @@map("notification_status")
}

/// One notification, and the record that it happened exactly once (ADR-0005).
///
/// `dedupe_key` is the **second** of the two independent idempotency layers. The
/// first is BullMQ's deterministic `jobId`; this one is a UNIQUE index in
/// Postgres, so even a flushed, replayed or migrated queue cannot produce a second
/// message. Either layer alone would cover most failure modes. Both are cheap and
/// they fail independently.
model Notification {
  id     String @id @default(uuid(7))
  userId String @map("user_id")

  channel     NotificationChannel @default(TELEGRAM)
  /// Which Persian template renders it. The text lives in `packages/telegram`, so
  /// changing wording is a deploy rather than a migration.
  templateKey String              @map("template_key")
  /// The facts the template interpolates. Public ids only — this is rendered into
  /// a message body, so a Telegram identifier reaching here would reach a user
  /// (ADR-0009, invariant 7).
  payload     Json

  /// Exactly-once, in the database.
  dedupeKey         String             @unique @map("dedupe_key")
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  /// What Telegram called the message, so an edit or a delete can find it later.
  telegramMessageId Int?               @map("telegram_message_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  /// The bot's reply lookup: "which conversation is this a reply to?".
  ///
  /// A user replying to a relayed message in Telegram quotes a message id, and that
  /// id is the only thing that says which of their conversations they meant. Scoped
  /// by user, which is also the authorisation — an id from somebody else's
  /// conversation finds nothing.
  @@index([userId, telegramMessageId], map: "notification_delivered_idx")
  @@map("notification")
}

/// The dead-letter queue, mirrored into Postgres (ADR-0005).
///
/// A job that exhausts its retries becomes a **row** rather than a log line: it is
/// inspectable in the admin panel, it survives a Redis flush, and it can be
/// re-driven. "Every failed job is a durable, inspectable row" is the property,
/// and a log line is none of those things.
model JobFailure {
  id String @id @default(uuid(7))

  queue    String
  jobName  String @map("job_name")
  /// BullMQ's job id, which is deterministic — so a re-drive collides with the
  /// original rather than producing a second delivery.
  jobId    String @map("job_id")
  payload  Json
  error    String
  attempts Int    @default(0)

  /// Set when somebody re-drove it, so the queue does not re-run the same failure
  /// every time an admin opens the page.
  redrivenAt DateTime? @map("redriven_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  /// One row per failed job, so a re-driven job that fails again updates rather
  /// than accumulating.
  @@unique([queue, jobId])
  @@index([createdAt])
  @@index([redrivenAt])
  @@map("job_failure")
}

// ─────────────────────────────────────────────────────────────────────────────
// Channel publishing (M14, plan §3.3)
// ─────────────────────────────────────────────────────────────────────────────

/// Why an event earned a place in the channel.
///
/// Three reasons, and they are not interchangeable: VIP and BOOST are **bought**
/// (M9's two coin sinks), while TRENDING is **earned** by demand. Keeping them
/// apart is what lets the same event appear once for each reason without the
/// channel repeating itself — and what makes "did they pay for this?" answerable.
enum ChannelPostKind {
  VIP
  BOOSTED
  TRENDING
  /**
   * The host paid for this one specific publication (M22 phase 5).
   *
   * A fourth reason rather than a reuse of `BOOSTED`, and for the same argument
   * the other three make: "they bought a 24-hour lift", "they bought permanent VIP
   * standing" and "they bought one post in the channel" are three different
   * purchases at three different prices, and a ledger that cannot tell them apart
   * cannot answer what promotion earned.
   *
   * It is also the one kind whose claim row is **never released on failure**: the
   * others are re-derivable from `is_vip`, `boosted_until` and `request_count`, so
   * deleting a failed claim costs nothing. This one is the record that somebody
   * paid, and deleting it would lose the purchase.
   */
  PAID

  @@map("channel_post_kind")
}

/// One post in the channel, and the record that it happened once.
///
/// `UNIQUE (event_id, kind)` is the whole duplicate guard — the plan's "no
/// duplicate post per event per kind", in the database rather than in a check the
/// publisher has to remember. The publisher inserts and lets the index decide,
/// because a read-then-write has a window and a channel that double-posts is a
/// channel people mute.
model ChannelPost {
  id      String          @id @default(uuid(7))
  eventId String          @map("event_id")
  kind    ChannelPostKind

  /// What Telegram called it, which is what a later delete needs.
  telegramMessageId Int?      @map("telegram_message_id")
  postedAt          DateTime? @map("posted_at") @db.Timestamptz(3)
  /// Set when the post was removed because the event stopped being publishable.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  /// The delete sweep's read: posts that are live and whose event no longer is.
  @@index([deletedAt, postedAt])
  @@map("channel_post")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound campaigns (M22)
//
// One shape for three things that turned out to be the same thing: an admin
// messaging one user, an admin broadcasting to a filtered set, and a host paying
// to invite twenty people to their event. All three select recipients, need
// confirming before they cost anything, deliver through the one rate-limited
// queue, and have to be answerable afterwards — "who did we message, and what
// happened to each one?".
//
// Three properties are the database's rather than the service's:
//
//   - **`idempotency_key` is UNIQUE**, so a double-tapped «ارسال» produces one
//     campaign. It is derived from the intention (the admin, the filter hash, the
//     body) or supplied by the client, exactly as `coin_ledger.idempotency_key` is.
//   - **`UNIQUE (campaign_id, user_id)` on the recipients**, so a dispatcher that
//     runs twice cannot enqueue a second delivery to the same person.
//   - **`UNIQUE (event_id, user_id)` on invitations**, so nobody is invited to one
//     event twice however many times the host pays.
//
// `body_text` is stored. It is admin- or host-authored operational content rather
// than private correspondence — the thing a dispute is about is *what was sent* —
// and the chat retention rules (ADR-0009) apply to `chat_message`, which this is
// not.
// ─────────────────────────────────────────────────────────────────────────────

enum MessageCampaignKind {
  /// One named recipient (M22 phase 12).
  DIRECT
  /// A filtered set (phase 4).
  BROADCAST
  /// The paid top-20 invitation (phase 11).
  EVENT_INVITE

  @@map("message_campaign_kind")
}

/// The lifecycle, and the reason a broadcast cannot happen by accident.
///
/// `DRAFT → CONFIRMED` is a **separate request from a separate button**, and it is
/// the only edge that leads to delivery. A dry run stops at `COMPLETED` without
/// ever entering `QUEUED`, which is what makes "preview" and "send" different
/// verbs rather than a flag somebody can forget.
enum MessageCampaignStatus {
  DRAFT
  CONFIRMED
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED

  @@map("message_campaign_status")
}

/// What happened to one intended delivery.
///
/// Shared by `message_recipient` and `event_invitation` because the outcomes are
/// the same outcomes — and a second enum with the same members is a second thing
/// to keep in step with `TelegramClient.classify`.
///
/// `BLOCKED` and `INVALID` are **terminal and not failures**: there is nobody at
/// the other end, and retrying burns the rate budget other people's messages need
/// (ADR-0005). `SKIPPED` is a recipient the selection kept but delivery declined —
/// an account banned between selection and send.
enum DeliveryStatus {
  PENDING
  SENT
  RATE_LIMITED
  BLOCKED
  INVALID
  FAILED
  SKIPPED

  @@map("delivery_status")
}

model MessageCampaign {
  id       String @id @default(uuid(7))
  /// The only campaign identifier that appears in a URL or a response.
  publicId String @unique @default(uuid(4)) @map("public_id")
  /// Exactly-once, in the database. See the block comment above.
  idempotencyKey String @unique @map("idempotency_key")

  kind   MessageCampaignKind
  status MessageCampaignStatus @default(DRAFT)

  /// What is actually sent. Plain text unless `parse_mode` says otherwise, and
  /// the service refuses anything Telegram would reject rather than discovering
  /// it one recipient at a time.
  bodyText  String  @map("body_text")
  /// 'HTML' or null. The product already sends HTML through `TelegramClient`;
  /// nothing else is accepted.
  parseMode String? @map("parse_mode")

  /// The selection, as data — city ids, a status, a completeness flag. Never raw
  /// personal data, and never a list of Telegram identifiers: the recipients are
  /// rows in `message_recipient`, which reference `user` by internal id.
  filter Json @default("{}")

  /// What the preview told the operator before they confirmed. Kept so "you said
  /// 400 and sent 380" is answerable.
  estimatedRecipients Int @default(0) @map("estimated_recipients")
  /// `{ queued, sent, rateLimited, blocked, invalid, failed, skipped }`, maintained
  /// by the dispatcher. A cache of `GROUP BY status` over the recipients, kept so
  /// the list screen is one read rather than one aggregate per row.
  counts Json @default("{}")

  /// True for a rehearsal. A dry run selects recipients, writes them, reports the
  /// counts and **never enqueues a single job**.
  dryRun Boolean @default(false) @map("dry_run")

  /// Who asked for it. `ADMIN` for phases 4 and 12, `USER` for the host who paid
  /// for an invitation — reusing `ActorType` rather than declaring which of the
  /// two nullable columns is set, because the enum already answers that question
  /// everywhere else in this schema.
  actorType    ActorType @map("actor_type")
  actorAdminId String?   @map("actor_admin_id")
  actorUserId  String?   @map("actor_user_id")

  /// The event this is about, for an invitation or an event-scoped broadcast.
  eventId String? @map("event_id")

  /// The coins this cost, if it cost any (phase 5's 10- and 15-coin sinks).
  ///
  /// UNIQUE, so one ledger row can pay for at most one campaign — which is what
  /// makes the refund path safe: reversing this ledger row cannot silently refund
  /// a second campaign that claimed the same payment.
  coinLedgerId String? @unique @map("coin_ledger_id")

  confirmedByAdminId String? @map("confirmed_by_admin_id")
  cancelledByAdminId String? @map("cancelled_by_admin_id")

  /// Set when the circuit breaker tripped, with the reason. The campaign stays
  /// SENDING — it is paused, not failed — and the dispatcher stops claiming.
  pausedAt    DateTime? @map("paused_at") @db.Timestamptz(3)
  pauseReason String?   @map("pause_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  actorAdmin AdminUser?  @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)
  actorUser  User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ledger     CoinLedger? @relation(fields: [coinLedgerId], references: [id], onDelete: Restrict)

  recipients  MessageRecipient[]
  invitations EventInvitation[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([actorAdminId, createdAt])
  @@map("message_campaign")
}

/// One intended delivery, and the record of what became of it.
model MessageRecipient {
  id         String @id @default(uuid(7))
  campaignId String @map("campaign_id")
  userId     String @map("user_id")

  status   DeliveryStatus @default(PENDING)
  attempts Int            @default(0)
  /// The client's own classification, truncated. Never a raw Telegram payload and
  /// never a token — an operator reads this, and the token is configuration.
  lastError String?       @map("last_error")

  telegramMessageId Int?      @map("telegram_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign MessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// The duplicate guard. A dispatcher that runs twice inserts nothing the second
  /// time.
  @@unique([campaignId, userId])
  @@index([campaignId, status])
  /// The dispatcher's claim query, partial so it holds the backlog rather than
  /// every delivery the product has ever made.
  @@index([campaignId], map: "message_recipient_pending_idx", where: { status: "PENDING" })
  @@map("message_recipient")
}

/// Somebody the top-20 selector picked, and why (M22 phase 11).
///
/// Separate from `message_recipient` even though a campaign carries both, because
/// the question this table answers outlives the campaign: **"has this person
/// already been invited to this event?"** must stay a unique index long after the
/// campaign row has been read for the last time.
///
/// `score_breakdown` is the explainable snapshot — which terms fired and what each
/// contributed. It holds no personal data, only the host's own event's attributes
/// matched against a count: `{"sameCity": 30, "interestMatch": 20, …}`.
model EventInvitation {
  id         String  @id @default(uuid(7))
  eventId    String  @map("event_id")
  userId     String  @map("user_id")
  campaignId String? @map("campaign_id")

  score          Int
  scoreBreakdown Json @map("score_breakdown")

  status    DeliveryStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(3)

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  campaign MessageCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Invited at most once per event, for life.
  @@unique([eventId, userId])
  @@index([eventId, createdAt])
  /// The "penalise a recent invitation" term in the next selection's score.
  @@index([userId, createdAt])
  @@map("event_invitation")
}

// ─────────────────────────────────────────────────────────────────────────────
// The event channel, as something an admin configures (M22 phase 6)
//
// `TELEGRAM_CHANNEL_ID` has been an environment variable since M14 and stays one:
// it is the destination the *bot* posts to, and a destination that can be edited
// from a web panel is a destination an attacker with a session can redirect. This
// table is the other half — the **public** face of that channel and whether users
// must join it — none of which is a secret and all of which an operator needs to
// change without a deploy.
//
// A single row, pinned by a CHECK on the primary key. A settings table with one
// row is a settings table; a settings table with two rows is a bug nobody notices
// until the second one wins.
// ─────────────────────────────────────────────────────────────────────────────
model EventChannelConfig {
  /// Always `'default'`. The CHECK in migration 0021 is what makes that true.
  id String @id @default("default")

  /// What the Telegram API is given for a membership check: `@payetam` or
  /// `-1001234567890`. Never a token, never an invite hash.
  chatIdentifier String? @map("chat_identifier")
  /// The public @username, without the `@`. Null for a private channel.
  publicUsername String? @map("public_username")
  /// Where the «عضویت در کانال» button goes. Normalised to `https://t.me/…` on
  /// write and rejected otherwise — an unvalidated URL here is a phishing link
  /// the product would render for every user (T5.3, and the SSRF review in §13).
  inviteUrl      String? @map("invite_url")

  /// **Defaults to false, permanently.** Turning this on with a misconfigured
  /// channel locks out every user at once, so it is a decision somebody makes
  /// after the status indicator says the bot can actually see the channel.
  membershipRequired Boolean  @default(false) @map("membership_required")
  /// Which operations the requirement covers: `EVENT_CREATE`, `EVENT_JOIN`,
  /// `EVENT_CHANNEL_SEND`, `EVENT_INVITE`. Empty means none, which is what an
  /// unconfigured deployment has.
  requiredActions    String[] @default([]) @map("required_actions")
  /// Whether to ask Telegram. False means the requirement is advisory — the user
  /// is shown the join button and taken at their word, which is the honest
  /// setting for a channel the bot is not an administrator of.
  verifyViaTelegram  Boolean  @default(true) @map("verify_via_telegram")

  updatedByAdminId String?  @map("updated_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@map("event_channel_config")
}

/// A channel a user can be required to join before the product will let them act
/// (v0.3.1).
///
/// ── Why this is a table and `EventChannelConfig` is not ────────────────────
///
/// v0.3.0 held the channel's public face on the settings singleton, which can
/// describe exactly one channel. The requirement is now several, **in a stated
/// order** — the order they are joined in and the order they are listed in — so
/// the channels are rows and the singleton keeps only what is global: whether the
/// requirement is on, which operations it covers, whether Telegram is asked.
///
/// The singleton's three per-channel columns are still there and are no longer
/// read. Migration 0024 copied whatever they held into the first row of this
/// table; dropping them would have been a destructive statement in a feature
/// release.
///
/// **No secret is stored here.** `TELEGRAM_CHANNEL_ID` and the bot token stay
/// environment variables, for the reason `EventChannelConfig` gives: a posting
/// destination editable from a web session is one an attacker with a session can
/// redirect.
model RequiredChannel {
  id String @id @default(uuid(7))

  /// What the operator calls it, and what the user reads above the join button.
  /// Not derived from the username — «کانال اصلی» is what a reader needs.
  title String

  /// What `getChatMember` is given: `@payetam` or `-1001234567890`. Null means
  /// this channel cannot be verified, so every user passes it — which is the
  /// honest state for a channel the bot is not an administrator of.
  chatIdentifier String? @map("chat_identifier")
  /// The public @username, without the `@`. Null for a private channel.
  publicUsername String? @map("public_username")
  /// Where the «عضویت» button goes. Normalised to `https://t.me/…` on write and
  /// rejected otherwise — this is rendered as an `href` for every user.
  inviteUrl      String? @map("invite_url")

  /// Order of joining and of display. Sparse (10, 20, 30…) so inserting between
  /// two channels does not rewrite every row after it.
  sortOrder Int     @default(0) @map("sort_order")
  /// Deactivated rather than deleted: a channel that stops being required is
  /// usually required again later, and the audit trail reads better for it.
  isActive  Boolean @default(true) @map("is_active")

  updatedByAdminId String?  @map("updated_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("required_channel")
}

/// Which form a conversation is filling in (ADR-0017).
///
/// `ACCEPT_POLICIES` is first because it is the one that has to exist before the
/// Mini App can be retired: consent gates every write in the product, and until
/// the bot can take an acceptance, switching the Mini App off refuses everything
/// for everybody.
enum ConversationKind {
  ACCEPT_POLICIES
  COMPLETE_PROFILE
  EDIT_PROFILE
  CREATE_EVENT
  EDIT_EVENT
  /// The tags and the comment on a review whose rating is already in (v0.5.4).
  /// The rating is one tap from `/reviews`; this is the half that needs a form.
  WRITE_REVIEW
  /// A report's reason and its description (v0.5.8). `ReportService` has only
  /// `file` — no update path — so the description is collected before the row
  /// exists, which is what makes this a form rather than a follow-up.
  FILE_REPORT

  @@map("conversation_kind")
}

/// A half-filled form, held between two Telegram updates (ADR-0017).
///
/// ── Why `user_id` is UNIQUE ────────────────────────────────────────────────
///
/// One wizard at a time, per person. A user holds exactly one Telegram
/// conversation with the bot, so two simultaneous wizards would be two flows
/// writing to the same screen — and every message the second one edited would
/// destroy the first one's. The constraint is also what makes "whose draft is
/// this?" answerable without an id in the button: the draft is looked up by the
/// authenticated sender, so there is no identifier for a tamperer to swap.
///
/// ── Why the form data is encrypted ─────────────────────────────────────────
///
/// Most of what a draft holds becomes a public event. The description does not
/// have to: it is the user's own words, written before they decided to publish
/// them, and a draft that is abandoned is words they decided *not* to publish.
/// Same key and same shape as `chat_message` (ADR-0009), so there is one story
/// about encrypted columns rather than two.
///
/// ── `last_update_id` is the idempotency ────────────────────────────────────
///
/// Telegram retries any webhook call that did not answer 200, and a retried
/// update must not advance a wizard twice — the second advance would skip a
/// question. `update_id` is monotonic per bot, so an update whose id is not
/// greater than this one has been seen: the step is re-rendered rather than
/// advanced. This is the property ADR-0017 says replaces "the bot has no
/// memory", and it is the whole of it.
model ConversationState {
  id     String           @id @default(uuid(7))
  userId String           @unique @map("user_id")
  kind   ConversationKind
  /// The step key, owned by the wizard definition rather than by an enum here:
  /// adding a step to a form is not a migration.
  step   String

  formDataCiphertext Bytes @map("form_data_ciphertext")
  formDataNonce      Bytes @map("form_data_nonce")
  keyVersion         Int   @map("key_version")

  /// The message the wizard is drawn on, so the next step edits rather than
  /// appends. Null until the first render, and again whenever an edit failed and
  /// a fresh message had to be sent.
  lastMessageId Int? @map("last_message_id")

  /// What is being edited, for the wizards that edit something: an event public
  /// id for EDIT_EVENT. Null for the ones that create.
  targetPublicId String? @map("target_public_id")

  /// The highest Telegram `update_id` that has advanced this conversation.
  lastUpdateId BigInt @map("last_update_id")

  /// Seven days out (ADR-0017 §3). Long enough that somebody who starts an event
  /// on Friday can finish it on Monday, which the brief asked for explicitly.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("conversation_state")
}

/// What a person has chosen to be told about (v0.6.1).
///
/// Only notifications. Language is `user.locale` and privacy is
/// `user_profile.invite_opt_out`; both predate this table, and duplicating a
/// setting is how two sources of truth start.
///
/// A user who has never opened the settings screen has **no row**, and
/// `UserSettingsService` resolves that absence to the same defaults declared
/// here — so the table's existence never silently changes what somebody
/// receives.
model UserSettings {
  id     String @id @default(uuid(7))
  userId String @unique @map("user_id")

  /// Chat relays: somebody wrote to you in an anonymous conversation.
  notifyChat Boolean @default(true) @map("notify_chat")
  /// Activity lifecycle: requests, acceptances, waitlist moves, reminders.
  notifyEvents Boolean @default(true) @map("notify_events")
  /// Admin campaigns and paid invitations.
  notifyCampaigns Boolean @default(true) @map("notify_campaigns")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
