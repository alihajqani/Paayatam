# PayeTam — environment template
#
# Copy to .env and fill in locally:  cp .env.example .env
#
# PLACEHOLDERS ONLY. Never commit a real value to this file or any other tracked file.
# Every variable here is validated by packages/config at boot; the process REFUSES TO START
# if a required variable is missing or malformed. That is deliberate — a half-configured
# service that boots is worse than one that does not.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
# Public origin of the API, used to build webhook and deep-link URLs.
PUBLIC_API_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults. Change the password for anything non-local.
DATABASE_URL=postgresql://payetam:CHANGE_ME_LOCAL_ONLY@localhost:55432/payetam?schema=public

# Integration tests TRUNCATE every table before each test. Point them at their own
# database so your seeded development data survives: run `make db-test` once, then
# uncomment this. Without it the suite falls back to DATABASE_URL — which works,
# and empties it.
# TEST_DATABASE_URL=postgresql://payetam:CHANGE_ME_LOCAL_ONLY@localhost:55432/payetam_test

# ── Redis (cache, sessions, rate limits, BullMQ) ───────────────────────────────
REDIS_URL=redis://localhost:56379
# Namespace for BullMQ keys. Keep distinct per environment so a staging worker can
# never consume production jobs.
QUEUE_PREFIX=payetam:dev

# ── Telegram ───────────────────────────────────────────────────────────────────
# From @BotFather. Treat as a credential: it is full control of the bot.
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_WITH_BOT_TOKEN_FROM_BOTFATHER
# Random secret path segment for the webhook endpoint (ADR-0004).
#   generate:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET_PATH=REPLACE_WITH_RANDOM_HEX_24_BYTES
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token and compared in constant time.
#   generate:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=REPLACE_WITH_RANDOM_HEX_32_BYTES
# 'webhook' in production; 'polling' is a local-development convenience and is
# REFUSED when NODE_ENV=production (ADR-0004).
TELEGRAM_MODE=polling
# Channel for VIP/boosted posts (M14). Leave empty until that milestone.
TELEGRAM_CHANNEL_ID=
# The bot's username, without the leading @. Used to build the deep links that go
# into channel posts, into paid invitations, and — since v0.3.1 — into the Mini
# App's «رفتن به گفت‌وگو در تلگرام» button, which it reads from `GET /catalog`.
# A wrong value produces a broken link rather than a wrong destination. Optional
# locally; **required in production**, where an empty value silently degrades
# that button to "close the app" and leaves anybody who arrived from a channel
# post with no way into their conversation.
TELEGRAM_BOT_USERNAME=

# Where a user is sent when the product has stopped serving them: the last
# message a blocked account receives, and the refusal a suspended one gets on
# every write. A `@username` or an `https://t.me/...` link. Leave it empty and
# those messages simply omit the contact line — which is worse for the person
# reading them, so set it.
SUPPORT_CONTACT=

# ── Cryptography ───────────────────────────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM on chat message bodies and admin TOTP secrets.
#   generate:  openssl rand -base64 32
# Rotating this requires the re-encrypt job; key_version tracks which key encrypted what.
# NOTE (ADR-0009): this protects DB dumps, backups and a stolen disk. It does NOT
# protect against a compromised app server, which holds the key by design.
CHAT_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Pepper for HMAC-hashing IP addresses and user agents. We never store raw IPs.
#   generate:  openssl rand -base64 32
PII_HASH_PEPPER=REPLACE_WITH_BASE64_32_BYTE_KEY

# Signing keys for Mini App session tokens (ADR-0004).
#   generate:  openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_BASE64_48_BYTE_KEY
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_BASE64_48_BYTE_KEY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Localisation ───────────────────────────────────────────────────────────────
# Business timezone. Storage is always UTC; this drives policy boundaries and
# display only (ADR-0008).
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa-IR

# ── Media ──────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_BYTES=5242880

# ── Deployment topology ────────────────────────────────────────────────────────
# Which upstream hops may set X-Forwarded-For. Leave EMPTY for local development,
# where nothing sits in front of the API. Behind nginx it is mandatory: without it
# request.ip is the proxy's address, so every IP rate-limit bucket is shared by the
# whole internet and every ip_hash in audit_log is identical.
# Accepts a CIDR list (172.28.0.0/24), a hop count (1), or 'loopback'.
# 'true' is REFUSED — it would let any client forge its own address.
TRUST_PROXY=

# ── Monitoring ─────────────────────────────────────────────────────────────────
# Telegram chat the worker posts operational alerts to. A group id is negative
# (e.g. -1001234567890). Empty disables alerting entirely; nothing else changes.
MONITORING_CHAT_ID=
# Shortest gap between two alerts about the same thing, so a queue failing every
# job cannot fill the group and get the bot rate-limited.
MONITORING_ALERT_COOLDOWN_SECONDS=300
# Kill switch. 0 stops every alert without touching the chat id, so alerting can be
# silenced during a noisy incident and turned back on without finding the id again.
# The worker keeps logging locally either way — nothing is lost, only not sent.
MONITORING_ENABLED=1

# ── Bot conversation wizards (ADR-0017) ──────────────────────────────────────
# The rollback lever for /create_event and /edit_profile. Set to 0 and the bot is
# read-only again, as it was before this release. Drafts already in flight are
# kept and resume when it goes back on — turning this off is not destructive,
# which is what makes it usable during an incident.
ENABLE_CONVERSATION_WIZARD=1

# Floor for what is worth sending: info | warn | error. Alerts below it are logged
# locally and not delivered. 'info' in development to see the whole stream.
MONITORING_MIN_LEVEL=info
# Which deployment an alert came from, stamped on every message. Falls back to
# NODE_ENV — set it explicitly once there is more than one non-production
# environment, or two staging boxes produce indistinguishable alerts.
MONITORING_ENVIRONMENT=

# ── The release string ─────────────────────────────────────────────────────────
#
# `PAYETAM_VERSION` is what `GET /api/v1/version` answers with and what both
# frontends display. It is deliberately **not** a line here: locally it is unset
# and resolves to `local`, which is the honest answer, and in production it
# reaches the API through `environment:` in docker/docker-compose.prod.yml from
# the shell `deploy.sh` exports it in — so it is always the release being
# deployed, with nothing to keep in step by hand.
#
# Set it only to reproduce a version-mismatch banner while developing:
#   PAYETAM_VERSION=v0.3.0 pnpm --filter @payetam/api dev

# ── Safety rails ───────────────────────────────────────────────────────────────
# Seeding production requires BOTH this flag and an interactive typed confirmation,
# and writes an audit row (M17). Leave at 0.
ALLOW_PROD_SEED=0
