{
  "name": "payetam",
  "version": "0.1.0",
  "private": true,
  "description": "PayeTam — a Telegram marketplace for shared activities",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsc -b && (tsc -b --watch --preserveWatchOutput & pnpm -r --parallel --filter \"./apps/**\" dev)",
    "build": "tsc -b && pnpm --filter @payetam/miniapp build",
    "typecheck": "tsc -b && tsc -p tsconfig.typecheck.json && pnpm --filter @payetam/miniapp typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "db:generate": "pnpm --filter @payetam/db db:generate",
    "db:migrate": "pnpm --filter @payetam/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @payetam/db db:migrate:deploy",
    "db:studio": "pnpm --filter @payetam/db db:studio",
    "seed:policies": "tsx --env-file=.env tools/seed-policies.ts",
    "seed:catalog": "tsx --env-file=.env tools/seed-catalog.ts",
    "seed:blacklist": "tsx --env-file=.env tools/seed-blacklist.ts",
    "seed:rbac": "tsx --env-file=.env tools/seed-rbac.ts",
    "seed:settings": "tsx --env-file=.env tools/seed-settings.ts",
    "seed:events": "tsx --env-file=.env tools/seed-events.ts",
    "seed:gift-codes-dev": "tsx --env-file=.env tools/seed-gift-codes-dev.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@payetam/db": "workspace:*",
    "@payetam/domain": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
